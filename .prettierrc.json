{
  "useTabs": true,
  "singleQuote": true,
  "printWidth": 100,
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.astro"],
      "options": { "parser": "astro" }
    },
    {
      "files": ["*.md", "*.mdx", "*.yml", "*.yaml", "*.json"],
      "options": { "useTabs": false }
    }
  ]
}
