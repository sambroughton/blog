---
import { SITE } from '../consts';
import type { Crumb } from '../lib/breadcrumbs';
import { withBase } from '../lib/paths';
import Breadcrumb from '../components/Breadcrumb.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

// Self-hosted rather than the Google Fonts CDN: this is a static Pages site, so
// the fonts ship with the build and there is no third-party request on load.
// Only the weights actually used are imported.
import '@fontsource/archivo/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/700.css';
import '@fontsource/roboto-mono/400.css';
import '@fontsource/roboto-mono/400-italic.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Set for article pages so Open Graph reports the right type. */
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	/**
	 * Trail shown above the content, first crumb to last. Omitted on the home
	 * page, which is where every trail starts, and on 404, which has nowhere
	 * meaningful to sit in the hierarchy.
	 */
	crumbs?: Crumb[];
	/**
	 * Set by pages that centre their content in the 2xl reading column rather
	 * than filling the 5xl main, so the trail lines up with the copy under it
	 * instead of starting at the far left of a much wider box.
	 */
	narrow?: boolean;
}

const {
	title,
	description = SITE.description,
	ogType = 'website',
	publishedTime,
	crumbs = [],
	narrow = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} - ${SITE.shortTagline}`;

// Astro.url.pathname already includes `base`, so this must NOT go through
// withBase() or the prefix would be doubled.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		{
			/* The SVG is the mark itself and scales to any tab or bookmark size, so it is
		    declared with `sizes="any"` and wins wherever it is understood. Everything
		    below it is the fallback for browsers that ignore SVG icons, Safari among
		    them: the .ico for the Windows tab strip and bookmarks bar, the PNGs for
		    everything that would rather have one. 512 is what desktop shortcuts and
		    Android home screens reach for. Order is not what decides between them -
		    a browser picks by type support and declared size, not by position.

		    Every one of these is generated from favicon.svg by `npm run favicons`,
		    so the mark cannot drift between formats. Do not hand-edit them. */
		}
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} sizes="any" />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href={withBase('/favicon-512.png')} sizes="512x512" />
		<link rel="icon" type="image/png" href={withBase('/favicon-32.png')} sizes="32x32" />
		<link rel="icon" type="image/png" href={withBase('/favicon-16.png')} sizes="16x16" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${SITE.name} RSS`}
			href={withBase('/rss.xml')}
		/>

		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title ?? SITE.name} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{
			publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
	</head>

	<body class="bg-bg text-text min-h-screen font-sans antialiased">
		<a
			href="#main"
			class="focus:bg-blue focus:text-bg sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-1.5 focus:text-xs"
		>
			Skip to content
		</a>

		<SiteHeader />

		<main id="main" class="mx-auto max-w-5xl px-5 py-10">
			{
				crumbs.length > 0 && (
					<div class={narrow ? 'mx-auto max-w-2xl' : undefined}>
						<Breadcrumb crumbs={crumbs} />
					</div>
				)
			}
			<slot />
		</main>

		<SiteFooter />
	</body>
</html>
