---
import { SITE } from '../consts';
import { archiveYears, postsInProjects, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';
import Chevron from './Chevron.astro';

interface Props {
	/**
	 * Every published entry, projects included. Not the caller's page slice, and
	 * not the ledger's filtered list: this rail is built from the whole catalogue.
	 * The ledger pages hand over both lists for exactly this reason - see the note
	 * in index.astro.
	 */
	posts: Post[];
}

const { posts } = Astro.props;

// The newest few projects. `posts` is already newest-first out of
// getPublishedPosts(), so this is a filter and a slice, not a sort.
//
// This block is now the only place a project appears on the front of the site. The
// ledger beside it is articles only, so the two lists are disjoint rather than
// overlapping, and the rail has stopped being a second copy of the top of the page.
//
// That is a reversal. This was the newest entries regardless of tag, on the
// argument that a rail should show what is new and filtering it would leave the
// block empty until enough entries carried the tag. The emptiness argument still
// holds and is handled the plain way instead: with no projects published the block
// does not render at all, which is better than a heading over three entries that
// are not what it says they are.
const recent = postsInProjects(posts).slice(0, SITE.sidebarRecentCount);

// Years that actually have entries, so a year with nothing behind it is never
// offered.
const years = archiveYears(posts);

// Matches the "Latest" heading in EntryList so the rail's section titles read as
// the same tier of label. Kept as a const rather than inlined: it is the contract
// with that component, and all three sections below share it.
const heading = 'text-[0.68rem] uppercase tracking-[0.12em] text-blue';

// One row idiom, shared by all three blocks: a full-width anchor, the label
// against the left edge, hover brightening to text rather than shifting hue.
// min-h-11 is the usual 44px touch floor, dropped at md where the rail becomes a
// pointer-driven column beside the list.
const row =
	'text-text-2 hover:text-text flex min-h-11 items-center justify-between gap-3 py-1.5 text-sm transition-colors md:min-h-0';

// Two blocks: what is new, and when. Secondary discovery, against the header's
// site-level navigation.
//
// The rail has had a facet list twice and has none now. First "Popular Tags",
// which merged both vocabularies and took the busiest eight; then a complete run
// of Solutions tags, which replaced it on the argument that a portfolio's product
// list should be shown whole rather than ranked.
//
// Both are gone for the same reason, arrived at from opposite directions: the
// products are the header menu now. A rail listing them beside every page is the
// menu a second time, three inches lower, and the one thing it added - a route
// sideways from one product archive to another - the menu gives on every page
// including those. Topics are not here either; they are labels rather than
// destinations, so a rail full of them would be a block of text that does nothing.
//
// What is left is what the header cannot carry: the newest projects, and the
// years. Neither is a taxonomy, which is the plainest statement of the split -
// vocabulary in the header, everything else in the rail.
//
// "No recent or featured entries" was the old rule here, on the grounds that the
// ledger beside the rail is the recent entries and the hero above it is the
// featured ones. That rule is satisfied now rather than overruled: the ledger is
// articles and this block is projects, so the rail duplicates nothing on the page
// it sits beside. It was briefly broken - this block held the newest entries
// whatever their tag, which on page 1 of the home page meant three titles that
// were also the top three of the list beside them and, with nothing featured, the
// hero's three as well.
//
// One page still overlaps, and it is the honest exception: on /projects this block
// is the top of the listing beside it. Left alone deliberately, the same way the
// old note argued - excluding what is already on the page would leave projects 4
// to 6 under a heading that says recent.
//
// Still nothing else goes in here. No social or newsletter blocks. The rail is two
// ways into the archive, not a column of widgets.
---

{
	/* Sticky from md up, which is where the rail becomes a column beside the list
	   rather than a block stacked under it. Below that it is the last thing on the
	   page and there is nothing left to scroll past, so pinning it there would only
	   park it over the footer.

	   self-start is what makes the sticking work at all, and is easy to lose: a
	   grid item stretches to the height of its row by default, so the box would
	   already be as tall as the entry list beside it and have no travel to stick
	   through. Shrinking it to its own content is what leaves room to move.

	   top-10 matches the py-10 on <main>, so the gap above it once pinned is the
	   same as the gap it starts with. No offset for the header, which scrolls away
	   rather than sticking.

	   The overflow guard is kept even though the block it was added for - the run of
	   nine product tags, worth about 20rem on its own - has gone. Both remaining
	   blocks have known ceilings again (three entries at about 8.5rem, the years at
	   roughly 2rem a decade), so today this guards a future rather than a bug: the
	   years are the half that grows without anyone deciding to grow it, and a sticky
	   box taller than the viewport has a bottom that cannot be scrolled to. max-h
	   with overflow-y-auto is the whole fix; overscroll-contain stops a scroll inside
	   it from chaining to the page once it bottoms out. 5rem is the top-10 offset
	   plus room for the scrollbar to not sit against the viewport edge.

	   .ledger-rail is the hook for that scrollbar and does nothing else. It exists
	   because scrollbar-width does not inherit, so the three narrow panels on the
	   site have to be named one at a time - see the Scrollbars section in
	   global.css, which is also where the other two are listed. */
}
<aside
	class="ledger-rail space-y-8 md:sticky md:top-10 md:max-h-[calc(100vh-5rem)] md:self-start md:overflow-y-auto md:overscroll-contain"
	aria-label="Browse entries"
>
	{
		recent.length > 0 && (
			<nav aria-labelledby="sb-projects">
				{/* The only heading in the rail that is a link, and it earns it: the other
				    two name what is under them, this one also names a page. Styled as the
				    heading first and the link second - same size, case and accent as
				    "Archive" below, brightening to text on hover the way every other row
				    in the rail does - so it reads as a section title that happens to be
				    clickable rather than as a control sitting where a title should be.

				    The anchor is inside the h2 rather than around it, so the heading stays
				    the labelled element and aria-labelledby keeps pointing at it. */}
				<h2 id="sb-projects" class={heading}>
					<a href={withBase('/projects')} class="hover:text-text transition-colors">
						Recent Projects
					</a>
				</h2>
				{/* Titles alone: no date, no thumbnail, no description, and none of the
				    entry row's hover treatment. The rail is 15rem wide and a row of that
				    kind needs the ledger's measure to work; stripped to a title it is the
				    same shape as the two blocks below it, which is what keeps the rail
				    reading as one thing.

				    items-start rather than items-center, and leading-snug, because a title
				    wraps to two or three lines here where a year does not - so the text has
				    to sit against the top of the row rather than be centred in a box its
				    own height. */}
				<ul class="mt-1.5">
					{recent.map((post) => (
						<li>
							<a
								href={withBase(`/posts/${post.id}`)}
								class="text-text-2 hover:text-text flex min-h-11 items-start py-1.5 text-sm leading-snug transition-colors md:min-h-0"
							>
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}

	{
		years.length > 0 && (
			<nav aria-labelledby="sb-archive">
				<h2 id="sb-archive" class={heading}>
					Archive
				</h2>
				{/* One year per row, the year against the left edge and a chevron against
				    the right, rather than the wrapped inline run of years this was. The
				    row is what changes: the years used to sit as a line of small links
				    reading as one sentence of numbers, and at that size and spacing there
				    was nothing to say they were destinations rather than a caption. A full
				    -width row with a chevron at the end of it is the same affordance the
				    header menu and the pagination controls already use.

				    Hovers to text-text (--color-text) rather than to the accent: across the
				    site the thing under the pointer lights up, it does not change hue. Same
				    treatment as the breadcrumb and the header nav. Colour is the whole
				    hover here, with no nudge on the chevron, because that is the rail's
				    stated convention - and the chevron takes currentColor, so it brightens
				    with the year rather than needing a rule of its own.

				    The anchor carries the padding, not the li, so the empty middle of the
				    row is part of the target and the chevron is not a separate thing to
				    aim at. */}
				<ul class="mt-1.5">
					{years.map((entry) => (
						<li>
							<a href={withBase(`/archive/${entry.year}`)} class={row}>
								{entry.year}
								<Chevron direction="right" class="h-4 w-4 shrink-0" />
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</aside>
