---
import { archiveYears, topicFacets, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

// Each facet list already excludes empty values, so a section is rendered only
// when something sits behind it.
const topics = topicFacets(posts);
const years = archiveYears(posts);

const heading = 'font-mono text-[0.63rem] uppercase tracking-[0.14em] text-text-3';
---

<aside class="space-y-8" aria-label="Browse entries">
	{
		topics.length > 0 && (
			<nav aria-labelledby="sb-topics">
				<h2 id="sb-topics" class={heading}>
					Topics
				</h2>
				<ul class="mt-2.5 space-y-1.5">
					{topics.map((topic) => (
						<li class="flex items-baseline justify-between gap-3">
							<a
								href={withBase(`/topics/${topic.id}`)}
								class="text-text-2 hover:text-blue text-sm transition-colors"
							>
								{topic.label}
							</a>
							<span class="text-blue font-mono text-[0.65rem]">{topic.count}</span>
						</li>
					))}
				</ul>
			</nav>
		)
	}

	{
		years.length > 0 && (
			<nav aria-labelledby="sb-archive">
				<h2 id="sb-archive" class={heading}>
					Archive
				</h2>
				<ul class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs">
					{years.map((entry) => (
						<li>
							<a
								href={withBase(`/archive/${entry.year}`)}
								class="text-text-2 hover:text-blue transition-colors"
							>
								{entry.year}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</aside>
