---
import { archiveYears, topicFacets, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

// Each facet list already excludes empty values, so a section is rendered only
// when something sits behind it.
const topics = topicFacets(posts);
const years = archiveYears(posts);

const heading = 'text-[0.68rem] uppercase tracking-[0.12em] text-text-3';
---

<aside class="space-y-8" aria-label="Browse entries">
	{
		/* "Domains", not "Topics": the header's Topics link opens the full taxonomy
		   browser, whereas this is a quick filter over the current listing plus a
		   snapshot of where the writing is concentrated. Two controls labelled the
		   same thing read as duplicates even when they do different jobs. */
		topics.length > 0 && (
			<nav aria-labelledby="sb-domains">
				<h2 id="sb-domains" class={heading}>
					Domains
				</h2>
				<ul class="border-rule mt-3 border-t">
					{topics.map((topic) => (
						<li class="border-rule border-b">
							<a
								href={withBase(`/topics/${topic.id}`)}
								class="text-text-2 hover:text-blue flex items-baseline justify-between gap-3 py-2 text-sm transition-colors"
							>
								<span>{topic.label}</span>
								{/* tabular-nums so counts sit in a true column once any domain
								    reaches double figures. */}
								<span class="text-blue shrink-0 text-[0.72rem] tabular-nums">{topic.count}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}

	{
		years.length > 0 && (
			<nav aria-labelledby="sb-archive">
				<h2 id="sb-archive" class={heading}>
					Archive
				</h2>
				<ul class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
					{years.map((entry) => (
						<li>
							<a
								href={withBase(`/archive/${entry.year}`)}
								class="text-text-2 hover:text-blue transition-colors"
							>
								{entry.year}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</aside>
