---
import { archiveYears, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

// Years that actually have entries, so a year with nothing behind it is never
// offered.
const years = archiveYears(posts);

// Matches the "Latest" heading in EntryList so the rail's section title reads as
// the same tier of label. Kept as a const rather than inlined: it is the contract
// with that component, and a second section here would have to share it.
const heading = 'text-[0.68rem] uppercase tracking-[0.12em] text-blue';

// The rail is the archive and nothing else now.
//
// It carried a facet list of the primary vocabulary for as long as that
// vocabulary had no other way in: first domains and technologies as two lists,
// then categories as one. The header menu now lists every published category on
// every page, so the rail was restating it beside each listing - and doing it in
// a 15rem column that forced the long "Microsoft Defender for ..." labels into a
// narrower measure than the menu gives them.
//
// Time is the one axis the header does not carry, which is what is left here.
// Topics were never in this rail and still are not: they have their own index at
// /topics.
---

{
	/* Sticky from md up, which is where the rail becomes a column beside the list
	   rather than a block stacked under it. Below that it is the last thing on the
	   page and there is nothing left to scroll past, so pinning it there would only
	   park it over the footer.

	   self-start is what makes the sticking work at all, and is easy to lose: a
	   grid item stretches to the height of its row by default, so the box would
	   already be as tall as the entry list beside it and have no travel to stick
	   through. Shrinking it to its own content is what leaves room to move.

	   top-10 matches the py-10 on <main>, so the gap above it once pinned is the
	   same as the gap it starts with. No offset for the header, which scrolls away
	   rather than sticking.

	   No max-height or overflow guard: the rail is one heading and a wrapped row of
	   years, so it cannot outgrow the viewport and become partly unreachable. That
	   changes if a section is ever added back to it. */
}
<aside class="space-y-8 md:sticky md:top-10 md:self-start" aria-label="Browse entries">
	{
		years.length > 0 && (
			<nav aria-labelledby="sb-archive">
				<h2 id="sb-archive" class={heading}>
					Archive
				</h2>
				{/* Hovers to text-text (--color-text) rather than to the accent: across the
				    site the thing under the pointer lights up, it does not change hue. Same
				    treatment as the breadcrumb and the header nav. */}
				<ul class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
					{years.map((entry) => (
						<li>
							<a
								href={withBase(`/archive/${entry.year}`)}
								class="text-text-2 hover:text-text transition-colors"
							>
								{entry.year}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</aside>
