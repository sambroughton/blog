---
import type { TopicLabel } from '../consts';

interface Props {
	label: TopicLabel;
	/** Extra classes for the point of use, e.g. lifting it above a stretched link. */
	class?: string;
}

const { label, class: className = '' } = Astro.props;

// A topic, as a label rather than a destination.
//
// The name is now a small lie and is kept anyway: this is the component every
// caller already imports, and renaming it would touch more files than the change
// it describes. There is nothing to link to - /topics and the per-topic archives
// are gone, and consts.ts has the reasoning - so what was an <a> behind a `linked`
// prop is a <span> with no prop at all. A component that cannot be asked to render
// a dead link is better than one that can.
//
// Restoring the link means restoring the route: put the archive back, add the href
// here, and give this a `linked` prop again for the ledger row, where the row is
// one stretched link and a second target inside it would be a second tab stop to
// the same place the reader is already going.
---

<span class={`tag-topic ${className}`}>{label}</span>
