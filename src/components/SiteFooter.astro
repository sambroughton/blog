---
import { SITE } from '../consts';
import { withBase } from '../lib/paths';

const links = [
	{ href: '/topics', label: 'Topics' },
	{ href: '/about', label: 'About' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<footer class="mt-16 border-t border-slate-200 dark:border-slate-800">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-start justify-between gap-x-6 gap-y-3 px-5 py-8"
	>
		<div>
			<p class="font-display text-navy-900 dark:text-paper text-base">{SITE.name}</p>
			<p class="mt-1 font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">
				Personal site. Views are my own, not my employer's. Not affiliated with Microsoft.
			</p>
		</div>

		<nav aria-label="Footer" class="flex gap-5 font-mono text-xs">
			{
				links.map((link) => (
					<a
						href={withBase(link.href)}
						class="text-slate-600 transition-colors hover:text-amber-700 dark:text-slate-400 dark:hover:text-amber-400"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
