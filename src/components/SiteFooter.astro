---
import { SITE } from '../consts';
import { withBase } from '../lib/paths';

// Topics but not Categories, which is not an omission: categories have no index
// page - the header menu lists all of them on every page, so a page repeating
// that list was a second copy of it - while topics have one and nothing else
// links to it. The rail carries no vocabulary at all now, so this is the only
// route to the topics index outside the tags on an entry.
const links = [
	{ href: '/topics', label: 'Topics' },
	{ href: '/about', label: 'Disclaimer' },
];
---

<footer class="border-rule mt-20 border-t">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-start justify-between gap-x-6 gap-y-3 px-5 py-8"
	>
		<div>
			<p class="font-display text-text text-base font-bold">{SITE.name}</p>
			<p class="text-text-3 mt-1 text-[0.7rem]">
				Personal site. Views are my own, not my employer's. Not affiliated with Microsoft.
			</p>
		</div>

		<nav aria-label="Footer" class="flex gap-5 text-[0.72rem]">
			{
				links.map((link) => (
					<a href={withBase(link.href)} class="text-text-2 hover:text-blue transition-colors">
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
