---
import { SITE } from '../consts';
import { withBase } from '../lib/paths';

// The disclaimer is the reason this nav exists.
//
// It was in the header, labelled as such, on the /about route. It is a legal page
// rather than a destination - read once, if at all - so it belongs down here with
// the rest of the small print, and the header is the shorter for it: Topics,
// Search and About, and nothing else. The path is /disclaimer now; /about is the
// page about the blog.
//
// Topics stays as the plain-text route to the index, for a reader who has come to
// the bottom of a page rather than up to the header menu. Solutions are still not
// in here: they have no index page to link to, and the rail carries the complete
// list of them beside every listing. Search is not in here either - it is a way
// into the archive rather than small print, so it sits in the header beside the
// Topics menu, which is its only peer.
const links = [
	{ href: '/topics', label: 'Topics' },
	{ href: '/disclaimer', label: 'Disclaimer' },
];
---

<footer class="border-rule mt-20 border-t">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-start justify-between gap-x-6 gap-y-3 px-5 py-8"
	>
		<div>
			<p class="font-display text-text text-base font-bold">{SITE.name}</p>
			<p class="text-text-3 mt-1 text-[0.7rem]">
				Personal site. Views are my own, not my employer's. Not affiliated with Microsoft.
			</p>
		</div>

		<nav aria-label="Footer" class="flex gap-5 text-[0.72rem]">
			{
				links.map((link) => (
					<a href={withBase(link.href)} class="text-text-2 hover:text-blue transition-colors">
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
