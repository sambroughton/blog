---
import { NAV, SITE } from '../consts';
import { withBase } from '../lib/paths';
---

<header class="border-rule border-b">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		{/* Brand stacked over its tagline, as in sb-blog's header. */}
		<div class="min-w-0">
			{
				/* No hover colour on the brand: the wordmark should read as the site's
			    identity, not as another accent link. */
			}
			<a href={withBase('/')} class="font-display text-text block text-xl font-bold">
				{SITE.name}
			</a>
			{
				/* Set as authored rather than uppercased, and the 0.1em tracking went with
			    the caps: that letterspacing exists to open up all-caps and reads as
			    gappy in mixed case. Short enough to hold one line on a phone, so it is
			    not hidden below sm. */
			}
			<p class="text-text-3 mt-1 text-[0.6rem]">{SITE.tagline}</p>
		</div>

		<nav aria-label="Primary" class="flex items-center gap-6 text-[0.72rem]">
			{
				/* Underline wipes in from the left on hover: a scaleX transform on an
				   ::after rule, so it animates on the compositor rather than by
				   changing layout. Mirrored on focus-visible so keyboard users get the
				   same affordance. The global reduced-motion rule zeroes the duration,
				   which leaves the underline appearing instantly rather than sweeping. */
				NAV.map((item) => (
					<a
						href={withBase(item.href)}
						class="text-text-2 hover:text-blue relative inline-block transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-200 after:content-[''] hover:after:scale-x-100 focus-visible:after:scale-x-100"
					>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
