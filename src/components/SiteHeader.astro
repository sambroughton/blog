---
import { NAV, SITE } from '../consts';
import { withBase } from '../lib/paths';
---

<header class="border-rule border-b">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
			<a
				href={withBase('/')}
				class="font-display text-text hover:text-blue text-xl font-bold transition-colors"
			>
				{SITE.name}
			</a>
			<p class="text-text-3 font-mono text-[0.63rem] tracking-[0.1em] uppercase">{SITE.tagline}</p>
		</div>

		<nav aria-label="Primary" class="flex items-center gap-6 font-mono text-[0.72rem]">
			{
				NAV.map((item) => (
					<a href={withBase(item.href)} class="text-text-2 hover:text-blue transition-colors">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
