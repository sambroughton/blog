---
import { NAV, SITE } from '../consts';
import { withBase } from '../lib/paths';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-slate-200 dark:border-slate-800">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
			<a
				href={withBase('/')}
				class="font-display text-navy-900 dark:text-paper text-xl transition-colors hover:text-amber-700 dark:hover:text-amber-400"
			>
				{SITE.name}
			</a>
			<p class="font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">{SITE.tagline}</p>
		</div>

		<nav aria-label="Primary" class="flex items-center gap-5 font-mono text-xs">
			{
				NAV.map((item) => (
					<a
						href={withBase(item.href)}
						class="text-slate-600 transition-colors hover:text-amber-700 dark:text-slate-400 dark:hover:text-amber-400"
					>
						{item.label}
					</a>
				))
			}
			<ThemeToggle />
		</nav>
	</div>
</header>
