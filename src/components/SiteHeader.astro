---
import { NAV, SITE } from '../consts';
import { withBase } from '../lib/paths';
---

<header class="border-rule border-b">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		{/* Brand stacked over its tagline, as in sb-blog's header. */}
		<div class="min-w-0">
			<a
				href={withBase('/')}
				class="font-display text-text hover:text-blue block text-xl font-bold transition-colors"
			>
				{SITE.name}
			</a>
			{
				/* Set as authored rather than uppercased, and the 0.1em tracking went with
			    the caps: that letterspacing exists to open up all-caps and reads as
			    gappy in mixed case. Short enough to hold one line on a phone, so it is
			    not hidden below sm. */
			}
			<p class="text-text-3 mt-1 text-[0.6rem]">{SITE.tagline}</p>
		</div>

		<nav aria-label="Primary" class="flex items-center gap-6 text-[0.72rem]">
			{
				NAV.map((item) => (
					<a href={withBase(item.href)} class="text-text-2 hover:text-blue transition-colors">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
