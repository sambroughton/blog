---
// Imported as a component rather than through <Image />, which does not accept
// SVG: Astro inlines the file's markup at build time instead of optimising it as
// a raster asset. Stable since Astro 5.7.
// https://docs.astro.build/en/guides/images/#svg-components
import Logo from '../assets/logo.svg';
import { NAV, SITE } from '../consts';
import { getPublishedPosts, topicGroupFacets } from '../lib/collections';
import { withBase } from '../lib/paths';
import Chevron from './Chevron.astro';
import TopicGroupIcon from './TopicGroupIcon.astro';

// One menu, on the five areas of the work.
//
// It has been three things. First three rows to three taxonomy views, which asked
// a reader to pick a classification scheme before they had seen anything
// classified. Then the solutions - the Microsoft products - listed outright.
// Briefly the busiest individual topics, which put the right vocabulary in the
// header at the wrong grain: seven of eighteen subjects, re-ranked by volume on
// every build, is a menu whose contents move and which is never the whole of
// anything.
//
// Groups are the grain a top-level menu wants. Five rows, stable, each a door onto
// a body of work rather than a single subject, and between them they cover the
// archive - see TOPIC_GROUPS in consts.ts for how membership is derived, and note
// that no entry is tagged with a group by hand. The individual subjects are still
// a click away at /topics, which the last row and the label itself both reach, and
// the rail beside each listing carries the busiest of them as tags.
//
// No shortlisting and no cap, unlike the topic menu this replaces: five is the
// whole catalogue, so there is nothing to trim and nothing arbitrary about what is
// on show. SITE.navTopicCount went with that change.
//
// It reads the collection to build the list, so only groups with something
// published are in here: the menu can never offer an empty archive. Cloud is in
// exactly that position today, with both of its entries still drafts, so it
// appears in `astro dev` and not in a production build. No counts - the panel is a
// way through, and the numbers are on the index it ends with.
const groups = topicGroupFacets(await getPublishedPosts());
---

<noscript>
	{
		/* With scripting off, the caret button goes and the panel stays: it drops out
		   of its floating box and sits under the header links as a plain list, which is
		   the same treatment the narrow breakpoint already gives it. The "Topics" link
		   beside the caret is a plain anchor and needs nothing done to it.

		   This once hid the panel too and offered a link to an index in its place,
		   which stopped working when that index was removed and the fallback link had
		   nowhere to point. Showing the list itself is the honest answer, and it is
		   why the menu semantics are applied in JavaScript rather than baked into the
		   markup: with scripting off these are ordinary links in ordinary tab order,
		   and only the script turns them into a menu with roving focus. Nothing is
		   stranded behind a dead control either way - and less so now than then,
		   because the panel's own last row and the "Topics" link both reach /topics,
		   so the complete list is two plain anchors away with no script at all.

		   Up here rather than beside the panel because that markup sits inside a {}
		   expression, where the braces of a CSS rule would be read as another
		   expression. is:inline keeps the rule in the <noscript>, which is the whole
		   point: hoisted into the stylesheet it would hide the caret for everyone. */
	}
	<style is:inline>
		.nav-dropdown__toggle {
			display: none;
		}

		.site-nav {
			width: 100%;
		}

		.nav-dropdown {
			display: contents;
		}

		.nav-menu {
			position: static;
			order: 1;
			width: 100%;
			padding-left: 0;
			border: 0;
			box-shadow: none;
			opacity: 1;
			transform: none;
			visibility: visible;
			pointer-events: auto;
			transition: none;
		}
	</style>
</noscript>

<header class="border-rule border-b">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		{
			/* Brand stacked over its tagline, as in sb-blog's header, with the mark set
			   alongside the pair rather than against either line on its own.

			   One link around the whole brand rather than a separate one on the mark:
			   two adjacent links to the same page would give keyboard users two tab
			   stops and screen readers two announcements for a single destination. The
			   accessible name therefore runs "Sam's Blog Powered by learning...", which
			   is the visible text verbatim - deliberately not overridden with an
			   aria-label, since that would drop wording the reader can see. */
		}
		<a href={withBase('/')} class="flex min-w-0 items-center gap-3">
			{
				/* Sized to the exact height of the two lines beside it, so its top and
				   bottom edges land on theirs: the title's line box (text-xl, 1.25rem at
				   a 1.4 ratio = 1.75rem) plus the tagline's mt-1 (0.25rem) plus the
				   tagline's own line box (0.6rem inheriting the 1.5 from preflight =
				   0.9rem). The viewBox is cropped to the mark, so this is the glyph's
				   height rather than a padded box, and w-auto lets the 702x521 ratio set
				   the width.

				   aria-hidden rather than the alt="" this carried as a raster image, and
				   the inline equivalent of it: the site name sits immediately to the right
				   and says the same thing, so the mark is decoration. The asset carries no
				   title/desc of its own to be announced instead - that decision lives here,
				   at the point of use, because it is a fact about this placement.

				   Nothing to lazy-load or preload any more - the markup ships inside the
				   document, so the mark costs no request on any page.

				   width/height repeat the viewBox and are overridden by the classes above;
				   they are here so the element has intrinsic dimensions of its own. As a
				   raster <img> that came from the file, which is what let w-auto resolve
				   against the real ratio. An inline <svg> carrying only a viewBox leaves
				   that to the engine deriving a ratio from it, and an engine that does not
				   falls back to width:auto meaning "fill the line". */
			}
			<Logo width={702} height={521} class="h-[2.9rem] w-auto shrink-0" aria-hidden="true" />

			<span class="block min-w-0">
				{
					/* No hover colour on the brand: the wordmark should read as the site's
				    identity, not as another accent link. Spans rather than an h1/p pair,
				    because this sits inside the anchor now and a heading in the masthead
				    would compete with each page's own h1. */
				}
				<span class="font-display text-text block text-xl font-bold">
					{SITE.name}
				</span>
				{
					/* Set as authored rather than uppercased, and the 0.1em tracking went with
				    the caps: that letterspacing exists to open up all-caps and reads as
				    gappy in mixed case. Short enough to hold one line on a phone, so it is
				    not hidden below sm. */
				}
				<span class="text-text-3 mt-1 block text-[0.6rem]">{SITE.tagline}</span>
			</span>
		</a>

		{
			/* self-stretch so the dropdown can be offset from the header's bottom
			   border rather than from its controls' own box; wrapping so the menu can
			   drop onto a row of its own on a phone. */
		}
		<nav
			aria-label="Primary"
			class="site-nav flex flex-wrap items-center gap-x-6 gap-y-2 self-stretch text-[0.72rem]"
		>
			<div class="nav-dropdown" data-dropdown>
				{
					/* Two controls, not one, and the split is the point: "Topics" is a
					   destination and the caret is a disclosure, so they are a link and a
					   button rather than one element pretending to be both.

					   The alternative was a single anchor carrying aria-expanded, which is
					   one tab stop instead of two but gives a touch reader no way to reach
					   the panel at all - the tap navigates - and asks a keyboard user to
					   discover an arrow key with nothing announcing it. Two adjacent
					   controls to two different actions is not the duplicate-tab-stop
					   problem the brand link avoids further up; that one is two routes to a
					   single page, this is a route and a control.

					   The wrapper exists so the pair stays one flex item. Below 768px the
					   dropdown is display:contents so the panel can claim a row of its own,
					   and without this the nav's 1.5rem column gap would open up between
					   the label and its caret. */
				}
				<span class="nav-dropdown__control">
					<a id="topics-label" href={withBase('/topics')} class="nav-link" data-dropdown-label
						>Topics</a
					>

					{
						/* aria-label rather than visible text, which is the opposite of the
						   call made on the brand link above and for the opposite reason: there
						   is no wording here for a reader to see, so there is none to drop.
						   "Show" rather than "Toggle" because aria-expanded is what states
						   which way it goes.

						   aria-haspopup="menu" because the script gives the panel role="menu",
						   and the menu button pattern asks for the two to agree: a button
						   controlling a menu declares it. Kept in the markup rather than set
						   alongside the role in the script, since it is true of the control
						   whether or not the panel has been upgraded yet - with scripting off
						   the caret is hidden entirely, so there is no state where this is
						   announcing a menu that cannot open.
						   https://www.w3.org/WAI/ARIA/apg/patterns/menu-button/ */
					}
					<button
						type="button"
						id="topics-trigger"
						class="nav-dropdown__toggle"
						aria-label="Show topics"
						aria-haspopup="menu"
						aria-expanded="false"
						aria-controls="topics-menu"
						data-dropdown-trigger
					>
						{
							/* Rotated to point back at the trigger while the panel is open, by the
						    rule in global.css. */
						}
						<Chevron direction="down" class="h-3 w-3 shrink-0" />
					</button>
				</span>

				{
					/* The five areas, then a row to the subjects inside them. This is the
					   complete list rather than a shortlist, so the last row is not a way to
					   see the rest of these - it is the way down a level, to the eighteen
					   individual subjects on /topics.

					   Neither vocabulary is listed here directly any more. The topics are
					   what the groups are built out of and are on the index below; the
					   solutions are in the rail, as a complete run of tags, and in the search
					   filters. Putting either in the header at full length is the browsing
					   problem this menu exists to simplify.

					   No role or tabindex in the markup - the script adds them. See the
					   <noscript> at the top of this file: without it these have to stay
					   ordinary links in ordinary tab order. */
				}
				<div id="topics-menu" class="nav-menu" data-dropdown-menu>
					{
						/* Presentational: with scripting on, the panel's accessible name comes
						   from the "Topics" link via the aria-labelledby the script sets, so
						   announcing this as a second label would repeat it. */
					}
					<p class="nav-menu__label" aria-hidden="true">Topics</p>

					{
						/* The glyph is aria-hidden inside the component, so each row's
						   accessible name stays the label alone. */
					}
					{
						groups.map((group) => (
							<a class="nav-menu__row nav-menu__row--icon" href={withBase(`/topics/${group.slug}`)}>
								<TopicGroupIcon name={group.icon} class="h-4 w-4 shrink-0" />
								<span>{group.label}</span>
							</a>
						))
					}

					{
						/* Ruled off above, so the five areas read as a set and this reads as the
						   way out of it rather than as a sixth area called "All topics". No glyph
						   on it, which is the other half of that: it is not one of them. */
					}
					<a class="nav-menu__row nav-menu__row--all" href={withBase('/topics')}>All topics</a>
				</div>
			</div>

			{
				NAV.map((item) => (
					<a href={withBase(item.href)} class="nav-link">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	// Open state lives as one attribute on the wrapper, so every rule in the
	// stylesheet only ever has to look at [data-open]. Both controls and the panel
	// are inside it, which also makes them a single hover region.
	const wrapper = document.querySelector('[data-dropdown]');
	const control = wrapper?.querySelector('.nav-dropdown__control');
	const label = wrapper?.querySelector('[data-dropdown-label]');
	const trigger = wrapper?.querySelector('[data-dropdown-trigger]');
	const menu = wrapper?.querySelector('[data-dropdown-menu]');

	if (
		wrapper instanceof HTMLElement &&
		control instanceof HTMLElement &&
		label instanceof HTMLAnchorElement &&
		trigger instanceof HTMLButtonElement &&
		menu instanceof HTMLElement
	) {
		// The panel ships as a plain list of links and becomes a menu here, because
		// the menu contract is one this script is what honours: roving focus needs
		// tabindex="-1" on every item, and with scripting off that would be a list of
		// links nothing could reach by keyboard. Selecting on .nav-menu__row rather
		// than on the role it is about to be given, for the same reason.
		const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('.nav-menu__row'));

		menu.setAttribute('role', 'menu');
		// Named by the visible "Topics" link rather than by the caret that opens it:
		// the caret's accessible name is "Show topics", and a panel announced as
		// "Show topics menu" describes the control instead of the contents.
		menu.setAttribute('aria-labelledby', label.id);
		for (const item of items) {
			item.setAttribute('role', 'menuitem');
			item.tabIndex = -1;
		}

		// A diagonal path from the trigger down to the panel crosses the gap between
		// them and leaves the hover region on the way. Closing on a short delay
		// rides that out; coming back cancels it.
		const GRACE_MS = 150;
		let closeTimer = 0;

		const isOpen = () => wrapper.hasAttribute('data-open');

		const open = () => {
			window.clearTimeout(closeTimer);
			wrapper.setAttribute('data-open', '');
			trigger.setAttribute('aria-expanded', 'true');
		};

		const close = () => {
			window.clearTimeout(closeTimer);
			wrapper.removeAttribute('data-open');
			trigger.setAttribute('aria-expanded', 'false');
		};

		// Wraps at both ends, as a menu is expected to. Negative indices count back
		// from the last item, so -1 is "the bottom of the list".
		const focusItem = (index: number) => {
			if (items.length === 0) return;
			items[((index % items.length) + items.length) % items.length].focus();
		};

		trigger.addEventListener('click', () => {
			if (isOpen()) close();
			else open();
		});

		// Mouse only. A touch reports as a pointerenter too, and opening on it would
		// leave the tap that follows to toggle the menu straight back shut - and
		// (hover: hover) is no help, since a touchscreen laptop matches it.
		wrapper.addEventListener('pointerenter', (event) => {
			if (event.pointerType === 'mouse') open();
		});

		wrapper.addEventListener('pointerleave', (event) => {
			if (event.pointerType !== 'mouse') return;
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(close, GRACE_MS);
		});

		// Enter and Space are the button's own doing, and Enter on the link is the
		// browser's. Arrows open the menu and land on an end of it, and are swallowed
		// so the page does not scroll out from under what just opened.
		//
		// Bound to the wrapper around both controls rather than to the caret alone,
		// so the arrows work with focus on either. A keyboard reader tabbing along
		// the header lands on "Topics" first, and that is the point they are most
		// likely to try one.
		control.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			event.preventDefault();
			open();
			focusItem(event.key === 'ArrowDown' ? 0 : -1);
		});

		menu.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			event.preventDefault();
			const current = items.findIndex((item) => item === document.activeElement);
			focusItem(current + (event.key === 'ArrowDown' ? 1 : -1));
		});

		// Escape closes, and hands focus back to the trigger only if it was inside
		// the menu to begin with: a panel opened by hover can be dismissed from the
		// keyboard without dragging the reader's focus up into the header.
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !isOpen()) return;
			const wasInside = wrapper.contains(document.activeElement);
			close();
			if (wasInside) trigger.focus();
		});

		// Clicking anywhere outside dismisses it.
		document.addEventListener('click', (event) => {
			if (!isOpen()) return;
			if (event.target instanceof Node && !wrapper.contains(event.target)) close();
		});

		// Tabbing past the last item closes it rather than leaving an open menu
		// floating over the page.
		wrapper.addEventListener('focusout', (event) => {
			if (event.relatedTarget instanceof Node && wrapper.contains(event.relatedTarget)) return;
			close();
		});
	}
</script>
