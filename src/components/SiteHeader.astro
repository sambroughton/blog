---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { NAV, SITE } from '../consts';
import { getPublishedPosts, topicsByDomain } from '../lib/collections';
import { withBase } from '../lib/paths';

// Built from the collection, so the menu can never list a topic with nothing
// published behind it, nor miss one that just gained its first entry.
//
// Topics here, domains in the sidebar: the two never list the same things. No
// counts on purpose - they earn their place on the index page, but in a menu
// they sit between the reader and the destination.
const groups = topicsByDomain(await getPublishedPosts());
---

<header class="border-rule border-b">
	<div
		class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-5"
	>
		{
			/* Brand stacked over its tagline, as in sb-blog's header, with the mark set
			   alongside the pair rather than against either line on its own.

			   One link around the whole brand rather than a separate one on the mark:
			   two adjacent links to the same page would give keyboard users two tab
			   stops and screen readers two announcements for a single destination. The
			   accessible name therefore runs "Sam's Blog Powered by learning...", which
			   is the visible text verbatim - deliberately not overridden with an
			   aria-label, since that would drop wording the reader can see. */
		}
		<a href={withBase('/')} class="flex min-w-0 items-center gap-3">
			{
				/* Sized to the exact height of the two lines beside it, so its top and
				   bottom edges land on theirs: the title's line box (text-xl, 1.25rem at
				   a 1.4 ratio = 1.75rem) plus the tagline's mt-1 (0.25rem) plus the
				   tagline's own line box (0.6rem inheriting the 1.5 from preflight =
				   0.9rem). The file is cropped to the mark, so this is the glyph's
				   height rather than a padded box. alt is empty because the site name
				   sits immediately to the right and says the same thing.

				   Eager: it sits in the header on every page, so Astro's lazy default
				   would only delay a 7KB image that is always in the first viewport. */
			}
			<Image src={logo} alt="" loading="eager" class="h-[2.9rem] w-auto shrink-0" />

			<span class="block min-w-0">
				{
					/* No hover colour on the brand: the wordmark should read as the site's
				    identity, not as another accent link. Spans rather than an h1/p pair,
				    because this sits inside the anchor now and a heading in the masthead
				    would compete with each page's own h1. */
				}
				<span class="font-display text-text block text-xl font-bold">
					{SITE.name}
				</span>
				{
					/* Set as authored rather than uppercased, and the 0.1em tracking went with
				    the caps: that letterspacing exists to open up all-caps and reads as
				    gappy in mixed case. Short enough to hold one line on a phone, so it is
				    not hidden below sm. */
				}
				<span class="text-text-3 mt-1 block text-[0.6rem]">{SITE.tagline}</span>
			</span>
		</a>

		<nav aria-label="Primary" class="flex items-center gap-6 text-[0.72rem]">
			{
				groups.length > 0 && (
					<details class="nav-dropdown" data-topics-menu>
						<summary class="nav-link" aria-label="Topics menu">
							Topics
							<svg
								width="11"
								height="11"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</summary>

						{/* Compact mega-menu: topics grouped under the domain they belong to,
						    laid out in columns so it stays wide and shallow rather than
						    becoming one long scrolling list as the blog grows. */}
						<div class="nav-menu">
							<div class="nav-menu__columns">
								{groups.map((group) => (
									<section class="nav-menu__group">
										<h2 class="nav-menu__heading">{group.label}</h2>
										{group.topics.map((topic) => (
											<a href={withBase(`/topics/${topic.id}`)}>{topic.label}</a>
										))}
									</section>
								))}
							</div>
							<a class="nav-menu__all" href={withBase('/topics')}>
								View all topics <span aria-hidden="true">→</span>
							</a>
						</div>
					</details>
				)
			}

			{
				NAV.map((item) => (
					<a href={withBase(item.href)} class="nav-link">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const menu = document.querySelector('[data-topics-menu]');

	if (menu instanceof HTMLDetailsElement) {
		const close = () => {
			menu.open = false;
		};

		// Clicking anywhere outside dismisses it.
		document.addEventListener('click', (event) => {
			if (!menu.open) return;
			if (event.target instanceof Node && !menu.contains(event.target)) close();
		});

		// Escape closes and hands focus back to the summary, so keyboard users are
		// not stranded inside a menu that is no longer on screen.
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !menu.open) return;
			close();
			menu.querySelector('summary')?.focus();
		});

		// Tabbing past the last item closes it rather than leaving an open menu
		// floating over the page.
		menu.addEventListener('focusout', (event) => {
			if (event.relatedTarget instanceof Node && menu.contains(event.relatedTarget)) return;
			close();
		});
	}
</script>
