---
import { withBase } from '../lib/paths';
import { slugify } from '../lib/slug';

interface Props {
	/**
	 * Area and topic labels, coarsest first, already capped by the caller.
	 * rowTaxonomy() in lib/collections.ts is what builds and caps this.
	 */
	facets: readonly string[];
	/**
	 * Reading time, appended after the facets. Omit where the page already states
	 * it - an entry page carries it on the date line above this one, and printing
	 * it twice within two lines is worse than the small asymmetry of an optional
	 * prop.
	 */
	minutes?: number;
	/**
	 * Link each value to its /topics archive. Off on a ledger row, where the row is
	 * one stretched link. On an entry page it is on: a reader who has opened the
	 * entry is the one who might follow a subject sideways.
	 */
	linked?: boolean;
}

const { facets, minutes, linked = true } = Astro.props;

// The line under a title: the subject area, the topics, then the reading time.
//
// This used to be one bordered tag and the reading time, and the comment here
// argued hard against ever showing more - an entry carries two or three topics,
// so a row would end up with four tags under a two-line headline and the list
// would read as a tag cloud with titles in it. That objection is answered rather
// than overruled, in two ways. These are no longer tags: one colour, one size, no
// borders, middot-separated, on one line, which is a caption and not a row of
// controls. And the count is capped - SITE.rowFacetCount - so the line cannot grow
// into the cloud that was being guarded against. The full list is still on the
// entry page, which is where it always belonged.
//
// It is also the shape HeroCarousel's featured card already uses for the same job:
// date · reading time · product, middots, one colour, no boxes.
//
// Both vocabularies resolve to /topics/<slug>. Areas and topics genuinely share
// that segment - topics/[topic].astro serves both from one route - and
// assertNoTopicSlugCollisions() is what guarantees the slug is unambiguous, so one
// derivation covers both and this needs no union to tell them apart. `string`
// rather than a label type for the same reason: the two vocabularies meet here,
// and Facet<Label = string> sets the precedent for widening where a caller only
// needs the shape. Every value handed in is a real catalogue label.
//
// Nothing here is z-lifted above the row's stretched link, unlike the tag this
// replaced. With linked={false} on a row there is nothing to lift: the whole line
// is part of the row's click target, which is what you want.
---

{
	/* Separators are drawn before each item rather than after it, so the line can
	   end on any of them: facets may be empty (an entry whose subjects no group
	   claims, on a page that also drops its topics) and minutes may be absent. A
	   trailing middot with nothing after it is the bug that shape avoids.

	   Decorative, hence aria-hidden: they divide facts that are already separate
	   elements, and read aloud they are noise between them. */
}
<div class="text-text-3 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
	{
		facets.map((facet, index) => (
			<Fragment>
				{index > 0 && <span aria-hidden="true">·</span>}
				{linked ? (
					<a
						href={withBase(`/topics/${slugify(facet)}`)}
						class="hover:text-text no-underline transition-colors"
					>
						{facet}
					</a>
				) : (
					<span>{facet}</span>
				)}
			</Fragment>
		))
	}

	{
		minutes !== undefined && (
			<Fragment>
				{facets.length > 0 && <span aria-hidden="true">·</span>}
				<span>{minutes} min read</span>
			</Fragment>
		)
	}
</div>
