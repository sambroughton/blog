---
import type { CategoryLabel, TopicLabel } from '../consts';
import CategoryTag from './CategoryTag.astro';
import TopicLink from './TopicLink.astro';

/**
 * A discriminated union rather than two optional props, so "exactly one of these"
 * is something the compiler enforces instead of something a comment asks for.
 */
type Props = { minutes: number; linked?: boolean } & (
	{ tag: 'category'; label: CategoryLabel } | { tag: 'topic'; label: TopicLabel }
);

const { minutes, linked = true, ...facet } = Astro.props;

// The meta line under a ledger row: one taxonomy value and the reading time,
// nothing else. Never the full list of either vocabulary - an entry carries two
// or three topics, so a row would end up with four tags under a two-line
// headline and the list would read as a tag cloud with titles in it. Both lists
// sit on the entry page, where a reader who has already chosen the entry is the
// one who might follow a subject sideways.
//
// Which vocabulary is the useful one depends on the page, which is why the
// caller picks. On the ledger it is the category, the primary classification. On
// a category archive every row would carry the same category - the one in the
// heading above them - so the tag says nothing there, and the topic is what
// actually separates one row from the next.
//
// The tag lifts itself above the row's stretched link in EntryList, or it would
// stop being clickable. The two keep their own weights: an outlined category, a
// quieter topic, exactly as on the entry page.
---

<div class="text-text-3 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
	{
		facet.tag === 'category' ? (
			<CategoryTag label={facet.label} linked={linked} class="entry-row__tag relative z-[2]" />
		) : (
			<TopicLink label={facet.label} linked={linked} class="entry-row__tag relative z-[2]" />
		)
	}

	{
		/* Decorative separator, hence aria-hidden: it divides two facts that are
	    already separate elements, and read aloud it is noise between them. */
	}
	<span aria-hidden="true">·</span>

	<span>{minutes} min</span>
</div>
