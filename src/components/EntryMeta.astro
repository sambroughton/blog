---
import type { TopicLabel } from '../consts';
import type { RowTag } from '../lib/collections';
import SolutionTag from './SolutionTag.astro';
import TopicLink from './TopicLink.astro';

interface Props {
	/**
	 * The single tag a ledger row carries. rowTag() in lib/collections.ts picks
	 * which vocabulary it comes from: the product, or the primary topic on a page
	 * that is already one product.
	 *
	 * Mutually exclusive with `topics` below - a row passes this, an entry page
	 * passes that - but not modelled as a union, because the two are read by
	 * different callers and an optional pair keeps the call sites plain.
	 */
	tag?: RowTag;
	/**
	 * Every topic an entry carries, for the entry page. Uncapped, unlike a row:
	 * this is the page a reader has already chosen, so the full list belongs here
	 * and nowhere else.
	 */
	topics?: readonly TopicLabel[];
	/**
	 * Reading time, appended after the tags. Omit where the page already states
	 * it - an entry page carries it on the date line above this one, and printing
	 * it twice within two lines is worse than the small asymmetry of an optional
	 * prop.
	 */
	minutes?: number;
}

const { tag, topics, minutes } = Astro.props;

// The line under a title: one tag, or an entry's full topic list, then the
// reading time.
//
// Back to one tag per row after a spell showing three unlinked values on a middot
// line - the subject area, then the topics. That line went with the area layer it
// was built for: with groups removed it was topics alone, and three plain-text
// tags under a two-line headline is the tag cloud the original note here argued
// against, with the added problem that none of them went anywhere.
//
// The two tags keep their own weights, as they do on the entry page: an outlined
// solution, a quieter topic. Only the solution is a link. Topics are labels a
// reader reads rather than follows - see the note on TOPICS in consts.ts - so
// TopicLink renders them as spans and there is no `linked` prop to get wrong here.
//
// The solution tag lifts itself above the row's stretched link in EntryList, or it
// would stop being clickable. Topics need no lift: they are not targets, so
// letting the row's own link sit over them is correct.
---

<div class="text-text-3 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
	{
		tag?.kind === 'solution' && (
			<SolutionTag label={tag.label} class="entry-row__tag relative z-[2]" />
		)
	}

	{tag?.kind === 'topic' && <TopicLink label={tag.label} class="entry-row__tag" />}

	{topics?.map((label) => <TopicLink label={label} />)}

	{
		/* Decorative separator, hence aria-hidden: it divides two facts that are
	    already separate elements, and read aloud it is noise between them.

	    Drawn only when something precedes it, so the line can end on the tags: an
	    entry page passes no `minutes`, and a caller could pass neither a tag nor a
	    topic list. A leading or trailing middot with nothing on one side of it is
	    the bug this shape avoids. */
	}
	{
		minutes !== undefined && (
			<Fragment>
				{(tag || topics?.length) && <span aria-hidden="true">·</span>}
				<span>{minutes} min read</span>
			</Fragment>
		)
	}
</div>
