---
import { topicLabel, type TopicId } from '../consts';
import { withBase } from '../lib/paths';

interface Props {
	topic: TopicId;
	minutes: number;
	/** Render the topic as a link to its filtered listing. */
	linked?: boolean;
}

const { topic, minutes, linked = true } = Astro.props;

const topicClasses = 'font-mono text-[0.63rem] tracking-[0.14em] uppercase text-blue';
---

{/* The topic is rendered as text, never colour alone, per WCAG 1.4.1. */}
<div class="text-text-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[0.65rem]">
	{
		linked ? (
			<a
				href={withBase(`/topics/${topic}`)}
				class={`${topicClasses} hover:text-blue-bright transition-colors`}
			>
				{topicLabel(topic)}
			</a>
		) : (
			<span class={topicClasses}>{topicLabel(topic)}</span>
		)
	}

	<span>{minutes} min</span>
</div>
