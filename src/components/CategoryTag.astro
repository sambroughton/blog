---
import type { CategoryLabel } from '../consts';
import { withBase } from '../lib/paths';
import { slugify } from '../lib/slug';

interface Props {
	label: CategoryLabel;
	/** Render as a link to the category archive. Off for previews and mockups. */
	linked?: boolean;
	/** Extra classes for the point of use, e.g. lifting it above a stretched link. */
	class?: string;
}

const { label, linked = true, class: className = '' } = Astro.props;

// No catalogue lookup any more, and none needed: the tag carried a glyph and a
// product colour that had to be read off the CATEGORIES entry, and with both
// gone the label is the whole tag. `label` is typed as CategoryLabel and the
// href is derived from it by the same slugify() the archive routes are built
// from, so there is nothing left here the catalogue could answer.
const href = withBase(`/categories/${slugify(label)}`);
---

{
	linked ? (
		<a href={href} class={`tag-category ${className}`}>
			{label}
		</a>
	) : (
		<span class={`tag-category ${className}`}>{label}</span>
	)
}
