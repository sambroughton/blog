interface Props {
	/**
	 * Which glyph to draw. Typed as the keys of PATHS, which is what makes the
	 * `icon` fields in consts.ts safe: naming a glyph this file does not carry is
	 * a type error rather than an empty box at runtime.
	 */
	name: keyof typeof PATHS;
	/** Overrides the default box. Tailwind sizing wins over the attributes below. */
	class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

<svg
	width="24"
	height="24"
	viewBox="0 -960 960 960"
	fill="currentColor"
	class={className}
	aria-hidden="true"
>
	<path d={PATHS[name]}></path>
</svg>
