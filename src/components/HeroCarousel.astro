---
import { Image } from 'astro:assets';
import { formatDate, isoDate, primarySolution, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/readingTime';
import Chevron from './Chevron.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const multiple = posts.length > 1;

// Every slide is in the DOM, so all featured entries are crawlable and the
// no-JS experience still shows the first one.
//
// Rotation is automatic on a 5s interval, which brings WCAG 2.2.2 into play:
// anything that moves on its own for longer than five seconds needs a way to
// stop it. With the explicit Pause control removed, that rests on the slide
// controls - a click on any dot, prev or next ends rotation for the visit -
// plus suspend-on-hover, suspend-on-focus, and starting paused under
// prefers-reduced-motion.
// https://www.w3.org/WAI/WCAG22/Understanding/pause-stop-hide.html
---

{
	posts.length > 0 && (
		<section
			class="mb-12"
			aria-roledescription="carousel"
			aria-label="Featured"
			data-carousel
			tabindex="-1"
		>
			<div class="hero-carousel__track" data-track aria-live="off">
				{posts.map((post, index) => {
					const minutes = readingTimeMinutes(post.body);
					return (
						/* Slides stack in one grid cell rather than being removed with
						   `hidden`, so the track is always as tall as the tallest entry and
						   the page below never jumps when a shorter one comes round.
						   Inactive slides are visibility:hidden, which keeps their space but
						   still takes them out of the tab order and the a11y tree. */
						<div
							data-slide
							data-index={index}
							data-active={index === 0 ? '' : undefined}
							role="group"
							aria-roledescription="slide"
							aria-label={`${index + 1} of ${posts.length}`}
						>
							{/* One continuous card. The cover is a background layer inside it,
							    not a second panel, so the card keeps a single border and a
							    single ground. `isolate` gives the z-indexes below their own
							    stacking context. */}
							<article class="featured-card bg-surface border-rule relative isolate overflow-hidden border">
								<div class="featured-card__image">
									{post.data.cover ? (
										<Image
											src={post.data.cover}
											alt={post.data.coverAlt ?? ''}
											widths={[640, 1024, 1600]}
											sizes="(min-width: 1024px) 62rem, 100vw"
											loading={index === 0 ? 'eager' : 'lazy'}
										/>
									) : (
										/* Stands in for a cover so an entry without one still reads as
										   a featured card. It takes the identical fade, so the two
										   states are indistinguishable in treatment. */
										<div class="featured-card__placeholder" aria-hidden="true" />
									)}
								</div>

								<div class="featured-card__content flex flex-col justify-between p-6 sm:p-8">
									<div>
										<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">
											Featured
											{multiple && (
												<span class="text-text-3">
													{' '}
													· {index + 1} of {posts.length}
												</span>
											)}
										</p>

										<h2 class="font-display text-text mt-4 text-2xl leading-tight font-bold sm:text-3xl">
											<a href={withBase(`/posts/${post.id}`)} class="no-underline">
												{post.data.title}
											</a>
										</h2>

										<p class="text-text-2 mt-3 max-w-[44ch] text-sm leading-relaxed">
											{post.data.description}
										</p>
									</div>

									<p class="text-text-3 mt-8 text-[0.72rem]">
										<time datetime={isoDate(post.data.pubDate)}>
											{formatDate(post.data.pubDate)}
										</time>
										{' · '}
										{minutes} min read
										{' · '}
										{primarySolution(post)}
									</p>
								</div>
							</article>
						</div>
					);
				})}
			</div>

			{multiple && (
				<div class="mt-3 flex items-center gap-3">
					<div class="flex gap-1.5" role="tablist" aria-label="Choose slide">
						{posts.map((_, index) => (
							<button
								type="button"
								data-dot
								data-index={index}
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-label={`Slide ${index + 1}`}
								class="bg-rule-bright aria-selected:bg-blue/30 relative h-1.5 w-6 cursor-pointer overflow-hidden transition-colors"
							>
								{/* The active bar keeps a dimmed blue ground so it still reads as
								    selected at zero progress; the fill on top is the countdown. */}
								<span class="hero-dot__fill" data-dot-fill />
							</button>
						))}
					</div>

					<div class="ml-auto flex gap-1.5">
						<button
							type="button"
							data-prev
							aria-label="Previous slide"
							class="border-rule text-text-2 hover:border-rule-bright hover:text-text inline-flex h-7 w-7 cursor-pointer items-center justify-center border text-xs transition-colors"
						>
							<Chevron direction="left" />
						</button>
						<button
							type="button"
							data-next
							aria-label="Next slide"
							class="border-rule text-text-2 hover:border-rule-bright hover:text-text inline-flex h-7 w-7 cursor-pointer items-center justify-center border text-xs transition-colors"
						>
							<Chevron direction="right" />
						</button>
					</div>
				</div>
			)}
		</section>
	)
}

<script>
	/** Hold per slide. Long enough to finish a headline plus its summary. */
	const ROTATE_MS = 8000;
	/** Must match the transition on [data-slide] in global.css. */
	const FADE_MS = 500;

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>('[data-track]');
		const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
		const dots = [...carousel.querySelectorAll<HTMLElement>('[data-dot]')];
		const fills = [...carousel.querySelectorAll<HTMLElement>('[data-dot-fill]')];
		if (!track || slides.length < 2) return;

		// An animation that starts on its own is precisely what this preference is
		// about, so rotation begins stopped. The slide controls still work, so the
		// carousel remains fully navigable by hand.
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		let current = 0;
		/**
		 * Advancement runs on a timer; the indicator fill is the matching visual.
		 * They are kept in step by deriving the timer's remaining time from the
		 * animation's currentTime, which pauses with it. Deliberately not driven by
		 * the animation's `finish` event: that event is not reliably dispatched
		 * (it does not fire at all under headless virtual time), which would leave
		 * the carousel stuck on the first slide.
		 */
		let clock: Animation | null = null;
		let timer: number | null = null;
		/** Milliseconds of the current hold still to run when it was last armed. */
		let holdLeft = ROTATE_MS;
		/** When that hold was armed, so elapsed time can be deducted on suspend. */
		let holdStartedAt = 0;
		/** Auto-rotation is over for this visit: manual nav or reduced motion. */
		let stopped = reduced.matches;
		/** Temporary hold while the pointer or focus is inside the carousel. */
		let suspended = false;

		function paint(previous: number) {
			slides.forEach((slide, i) => {
				slide.toggleAttribute('data-active', i === current);
			});
			dots.forEach((dot, i) => {
				dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
			});

			if (previous < 0 || previous === current) return;
			// Mark the outgoing slide so it drifts left rather than right, then drop
			// the flag once the fade is done. Guarded in case rapid clicks have made
			// this slide current again in the meantime.
			const leaving = slides[previous];
			leaving.toggleAttribute('data-leaving', true);
			window.setTimeout(() => {
				if (!leaving.hasAttribute('data-active')) leaving.removeAttribute('data-leaving');
			}, FADE_MS);
		}

		function clearTimer() {
			if (timer !== null) {
				window.clearTimeout(timer);
				timer = null;
			}
		}

		/**
		 * Start (or restart) the countdown with `ms` left to run.
		 *
		 * The remaining time is bookkept here rather than read back off the
		 * animation. The animation's clock can drift from wall time - it stalls
		 * whenever frames are not being produced - and resuming from a stalled
		 * currentTime computes a remainder of zero, which fires immediately and
		 * then again a full hold later, skipping a slide.
		 */
		function armHold(ms: number) {
			clearTimer();
			holdLeft = Math.max(0, ms);
			holdStartedAt = Date.now();
			timer = window.setTimeout(() => go(current + 1, false), holdLeft);
		}

		function clearClock() {
			clearTimer();
			clock?.cancel();
			clock = null;
			fills.forEach((fill) => {
				fill.style.transform = '';
			});
		}

		function startClock() {
			clearClock();
			const fill = fills[current];
			if (!fill) return;
			clock = fill.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
				duration: ROTATE_MS,
				easing: 'linear',
				fill: 'forwards',
			});
			if (suspended) {
				clock.pause();
				holdLeft = ROTATE_MS;
			} else {
				armHold(ROTATE_MS);
			}
		}

		/** Not rotating: show the active bar solid so it still reads as selected. */
		function showStatic() {
			clearClock();
			const fill = fills[current];
			if (fill) fill.style.transform = 'scaleX(1)';
		}

		function syncLive() {
			// Announce slide changes only when the reader is driving. A live region
			// firing every eight seconds unprompted is noise in a screen reader.
			track!.setAttribute('aria-live', stopped || suspended ? 'polite' : 'off');
		}

		function sync() {
			if (stopped) showStatic();
			else startClock();
			syncLive();
		}

		function go(next: number, byUser: boolean) {
			const previous = current;
			// Wrap in both directions so the controls never dead-end.
			current = (next + slides.length) % slides.length;
			paint(previous);
			// Someone steering by hand should not have to race the timer, so their
			// first manual move ends rotation for the rest of the visit.
			if (byUser) {
				stopped = true;
				sync();
			} else if (!stopped) {
				startClock();
			}
		}

		carousel.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1, true));
		carousel.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1, true));
		dots.forEach((dot, i) => dot.addEventListener('click', () => go(i, true)));

		// Hold while the reader is on it, so a slide cannot change mid-sentence.
		// Pausing the animation freezes the bar where it is and resumes from there.
		function setSuspended(value: boolean) {
			suspended = value;
			if (!stopped) {
				if (value) {
					// Bank the time already served, stand the timer down, freeze the bar.
					holdLeft = Math.max(0, holdLeft - (Date.now() - holdStartedAt));
					clearTimer();
					clock?.pause();
				} else {
					// Put the bar exactly where the banked remainder says it should be, so
					// the two cannot disagree, then run both again.
					if (clock) {
						clock.currentTime = ROTATE_MS - holdLeft;
						clock.play();
					}
					armHold(holdLeft);
				}
			}
			syncLive();
		}

		carousel.addEventListener('mouseenter', () => setSuspended(true));
		carousel.addEventListener('mouseleave', () => setSuspended(false));
		carousel.addEventListener('focusin', () => setSuspended(true));
		carousel.addEventListener('focusout', (event) => {
			// relatedTarget is where focus went; ignore moves within the carousel.
			if (!carousel.contains(event.relatedTarget as Node | null)) setSuspended(false);
		});

		carousel.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				go(current - 1, true);
			} else if (event.key === 'ArrowRight') {
				go(current + 1, true);
			} else {
				return;
			}
			event.preventDefault();
		});

		// Track the preference if it changes mid-session.
		reduced.addEventListener('change', () => {
			stopped = reduced.matches;
			sync();
		});

		sync();
	});
</script>
