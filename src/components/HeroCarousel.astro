---
import { Image } from 'astro:assets';
import { topicLabel } from '../consts';
import { formatDate, isoDate, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/readingTime';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const multiple = posts.length > 1;

// Every slide is in the DOM, so all featured entries are crawlable and the
// no-JS experience still shows the first one. Advance is manual only: an
// auto-rotating carousel would need a pause control to satisfy WCAG 2.2.2.
// https://www.w3.org/WAI/WCAG22/Understanding/pause-stop-hide.html
---

{
	posts.length > 0 && (
		<section
			class="mb-12"
			aria-roledescription="carousel"
			aria-label="Current work"
			data-carousel
			tabindex="-1"
		>
			<div class="grid gap-4 md:grid-cols-[1.55fr_1fr]">
				{posts.map((post, index) => {
					const minutes = readingTimeMinutes(post.body);
					return (
						<div
							class="contents"
							data-slide
							data-index={index}
							hidden={index !== 0}
							role="group"
							aria-roledescription="slide"
							aria-label={`${index + 1} of ${posts.length}`}
						>
							<div class="bg-surface border-rule flex flex-col justify-between border p-6 sm:p-8">
								<div>
									<p class="text-blue font-mono text-[0.63rem] tracking-[0.14em] uppercase">
										Current work
										{multiple && (
											<span class="text-text-3">
												{' '}
												· {index + 1} of {posts.length}
											</span>
										)}
									</p>

									<h2 class="font-display text-text mt-4 text-2xl leading-tight font-bold sm:text-3xl">
										<a
											href={withBase(`/posts/${post.id}`)}
											class="hover:decoration-text-3 underline decoration-transparent decoration-1 underline-offset-[0.18em] transition-colors"
										>
											{post.data.title}
										</a>
									</h2>

									<p class="text-text-2 mt-3 max-w-[44ch] text-sm leading-relaxed">
										{post.data.description}
									</p>
								</div>

								<p class="text-text-3 mt-8 font-mono text-[0.65rem]">
									<time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
									{' · '}
									{minutes} min
									{' · '}
									{topicLabel(post.data.topic)}
								</p>
							</div>

							<div class="bg-surface-2 border-rule hidden overflow-hidden border md:block">
								{post.data.cover ? (
									<Image
										src={post.data.cover}
										alt={post.data.coverAlt ?? ''}
										widths={[400, 800]}
										sizes="(min-width: 768px) 33vw, 100vw"
										class="h-full w-full object-cover"
										loading={index === 0 ? 'eager' : 'lazy'}
									/>
								) : (
									<div
										class="flex h-full min-h-52 items-center justify-center p-4"
										aria-hidden="true"
									>
										<span class="text-text-3 font-mono text-[0.63rem]">No cover image</span>
									</div>
								)}
							</div>
						</div>
					);
				})}
			</div>

			{multiple && (
				<div class="mt-3 flex items-center gap-3">
					<div class="flex gap-1.5" role="tablist" aria-label="Choose slide">
						{posts.map((_, index) => (
							<button
								type="button"
								data-dot
								data-index={index}
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-label={`Slide ${index + 1}`}
								class="bg-rule-bright aria-selected:bg-blue h-1.5 w-6 cursor-pointer transition-colors"
							/>
						))}
					</div>

					<div class="ml-auto flex gap-1.5">
						<button
							type="button"
							data-prev
							aria-label="Previous slide"
							class="border-rule text-text-2 hover:border-rule-bright hover:text-blue inline-flex h-7 w-7 cursor-pointer items-center justify-center border font-mono text-xs transition-colors"
						>
							‹
						</button>
						<button
							type="button"
							data-next
							aria-label="Next slide"
							class="border-rule text-text-2 hover:border-rule-bright hover:text-blue inline-flex h-7 w-7 cursor-pointer items-center justify-center border font-mono text-xs transition-colors"
						>
							›
						</button>
					</div>
				</div>
			)}
		</section>
	)
}

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
		const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
		const dots = [...carousel.querySelectorAll<HTMLElement>('[data-dot]')];
		if (slides.length < 2) return;

		let current = 0;

		function show(next: number) {
			// Wrap in both directions so the controls never dead-end.
			current = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.hidden = i !== current;
			});
			dots.forEach((dot, i) => {
				dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
			});
		}

		carousel.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
		carousel.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

		carousel.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				show(current - 1);
			} else if (event.key === 'ArrowRight') {
				show(current + 1);
			} else {
				return;
			}
			event.preventDefault();
		});
	});
</script>
