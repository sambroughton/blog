---
import { withBase } from '../lib/paths';

interface Props {
	currentPage: number;
	lastPage: number;
}

const { currentPage, lastPage } = Astro.props;

// Hrefs are built here rather than taken from Astro's `page.url`, so there is no
// ambiguity about whether `base` is already applied. Page 1 is the homepage
// (a static route, so it exists even with zero entries); pages 2+ live at
// /page/N, generated by src/pages/page/[page].astro.
const hrefFor = (n: number) => withBase(n === 1 ? '/' : `/page/${n}`);

/** 1 … around-current … last, collapsing long runs to an ellipsis. */
function pageWindow(current: number, last: number): (number | 'gap')[] {
	if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);

	const pages = new Set<number>([1, last, current]);
	if (current - 1 > 1) pages.add(current - 1);
	if (current + 1 < last) pages.add(current + 1);
	if (current <= 3) [2, 3, 4].forEach((n) => n < last && pages.add(n));
	if (current >= last - 2) [last - 3, last - 2, last - 1].forEach((n) => n > 1 && pages.add(n));

	const sorted = [...pages].sort((a, b) => a - b);
	const out: (number | 'gap')[] = [];
	sorted.forEach((page, i) => {
		if (i > 0 && page - sorted[i - 1] > 1) out.push('gap');
		out.push(page);
	});
	return out;
}

const items = pageWindow(currentPage, lastPage);

const cell =
	'inline-flex h-7 min-w-7 items-center justify-center border px-1.5 text-xs transition-colors';
const idle = 'border-rule text-text-2 hover:border-rule-bright hover:text-blue';
const active = 'border-blue bg-blue text-bg';
const disabled = 'border-rule text-text-3/40';
---

{/* Rendered by the caller only when lastPage > 1, but guard anyway. */}
{
	lastPage > 1 && (
		<nav aria-label="Pagination" class="mt-8 flex flex-wrap items-center gap-1.5">
			{currentPage > 1 ? (
				<a
					href={hrefFor(currentPage - 1)}
					rel="prev"
					class={`${cell} ${idle}`}
					aria-label="Previous page"
				>
					‹
				</a>
			) : (
				<span class={`${cell} ${disabled}`} aria-hidden="true">
					‹
				</span>
			)}

			{items.map((item) =>
				item === 'gap' ? (
					<span class="text-text-3 px-1 text-xs" aria-hidden="true">
						…
					</span>
				) : item === currentPage ? (
					<span class={`${cell} ${active}`} aria-current="page">
						{item}
					</span>
				) : (
					<a href={hrefFor(item)} class={`${cell} ${idle}`} aria-label={`Page ${item}`}>
						{item}
					</a>
				),
			)}

			{currentPage < lastPage ? (
				<a
					href={hrefFor(currentPage + 1)}
					rel="next"
					class={`${cell} ${idle}`}
					aria-label="Next page"
				>
					›
				</a>
			) : (
				<span class={`${cell} ${disabled}`} aria-hidden="true">
					›
				</span>
			)}
		</nav>
	)
}
