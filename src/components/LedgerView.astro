---
import { shouldShowSidebar, type Post } from '../lib/collections';
import EntryList from './EntryList.astro';
import HeroCarousel from './HeroCarousel.astro';
import Pagination from './Pagination.astro';
import Sidebar from './Sidebar.astro';

interface Props {
	/** Entries for this page only. */
	pagePosts: Post[];
	/** Every published entry, used for sidebar facet counts. */
	allPosts: Post[];
	/**
	 * Entries behind the whole ledger rather than this page of it, for the count in
	 * the list header. Not derivable from `allPosts`: that is every entry, projects
	 * included, and the ledger is the articles. So it comes from whichever caller
	 * did the slicing, which is the only place the two numbers are both in hand.
	 *
	 * Omitted by the callers that pass a complete list, and the count falls back to
	 * it. See EntryList.astro.
	 */
	totalPosts?: number;
	/** Featured entries for the hero. Pass an empty array to omit it. */
	heroPosts?: Post[];
	currentPage: number;
	lastPage: number;
	label?: string;
	emptyMessage?: string;
}

const {
	pagePosts,
	allPosts,
	totalPosts,
	heroPosts = [],
	currentPage,
	lastPage,
	label = 'Latest',
	emptyMessage,
} = Astro.props;

const showSidebar = shouldShowSidebar(allPosts.length);
---

{heroPosts.length > 0 && <HeroCarousel posts={heroPosts} />}

<div class={showSidebar ? 'grid gap-10 md:grid-cols-[1fr_15rem]' : ''}>
	<div class="min-w-0">
		<EntryList posts={pagePosts} total={totalPosts} label={label} emptyMessage={emptyMessage} />
		{lastPage > 1 && <Pagination currentPage={currentPage} lastPage={lastPage} />}
	</div>

	{showSidebar && <Sidebar posts={allPosts} />}
</div>
