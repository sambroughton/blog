---
import { formatDayMonth, isoDate, type Post } from '../lib/collections';
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/readingTime';
import EntryMeta from './EntryMeta.astro';

interface Props {
	posts: Post[];
	/** Heading shown above the list, e.g. "Latest". */
	label: string;
	/** Shown when there is nothing to list. */
	emptyMessage?: string;
}

const { posts, label, emptyMessage = 'No entries yet.' } = Astro.props;

// Honest count, correctly pluralised. A blog with one post says "1 article".
const countLabel = `${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`;
---

<section aria-label={label}>
	<div
		class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 pb-2 dark:border-slate-800"
	>
		<h2
			class="font-mono text-[0.68rem] tracking-[0.14em] text-amber-700 uppercase dark:text-amber-500"
		>
			{label}
		</h2>
		{
			posts.length > 0 && (
				<p class="font-mono text-[0.62rem] tracking-wider text-slate-400 uppercase dark:text-slate-500">
					{countLabel}
				</p>
			)
		}
	</div>

	{
		posts.length === 0 ? (
			<p class="py-10 font-mono text-sm text-slate-500 dark:text-slate-400">{emptyMessage}</p>
		) : (
			<ol class="mt-2">
				{posts.map((post) => {
					const minutes = readingTimeMinutes(post.body);
					return (
						<li class="py-5">
							<div class="sm:flex sm:gap-6">
								<time
									datetime={isoDate(post.data.pubDate)}
									class="block shrink-0 font-mono text-[0.68rem] leading-5 text-slate-500 sm:w-16 dark:text-slate-400"
								>
									{formatDayMonth(post.data.pubDate)}
									<span class="block text-slate-400 dark:text-slate-500">
										{post.data.pubDate.getUTCFullYear()}
									</span>
								</time>

								<div class="mt-1 min-w-0 sm:mt-0">
									<h3 class="font-display text-lg leading-snug">
										<a
											href={withBase(`/posts/${post.id}`)}
											class="text-navy-800 dark:text-paper underline decoration-transparent decoration-2 underline-offset-4 transition-colors hover:decoration-amber-600 dark:hover:decoration-amber-500"
										>
											{post.data.title}
										</a>
									</h3>

									<p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
										{post.data.description}
									</p>

									<div class="mt-2.5">
										<EntryMeta topic={post.data.topic} minutes={minutes} />
									</div>
								</div>
							</div>
						</li>
					);
				})}
			</ol>
		)
	}
</section>
