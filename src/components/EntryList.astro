---
import { formatDayMonth, isoDate, type Post } from '../lib/collections';
import { entryTint } from '../lib/entryTints';
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/readingTime';
import EntryMeta from './EntryMeta.astro';

interface Props {
	posts: Post[];
	/** Heading shown above the list, e.g. "Latest". */
	label: string;
	/** Shown when there is nothing to list. */
	emptyMessage?: string;
}

const { posts, label, emptyMessage = 'No entries yet.' } = Astro.props;

// Honest count, correctly pluralised. A blog with one post says "1 article".
const countLabel = `${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`;
---

<section aria-label={label}>
	<div class="border-rule flex flex-wrap items-baseline justify-between gap-2 border-b pb-3">
		<h2 class="text-blue text-[0.68rem] font-normal tracking-[0.12em] uppercase">
			{label}
		</h2>
		{
			posts.length > 0 && (
				<p class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">{countLabel}</p>
			)
		}
	</div>

	{
		posts.length === 0 ? (
			<p class="text-text-2 py-10 text-sm">{emptyMessage}</p>
		) : (
			<ol class="mt-2">
				{posts.map((post, index) => {
					const minutes = readingTimeMinutes(post.body);
					// The row is a hover reveal: a colour wash cross-fades in at 0.60
					// under two scrims, a 1px bar rises up the left edge and the copy
					// slides 10px right. Geometry and timing are in .entry-row in
					// global.css; the gradient comes from lib/entryTints.ts and is handed
					// over as --entry-tint.
					//
					// posts.length, not a fixed palette size: the hue ramp spans the whole
					// list, so the first row is indigo and the last is cyan-ish however
					// many there are. Nothing cycles.
					//
					// This replaces the sb-blog .mini treatment that was here (ground
					// lifting to surface-2, border brightening to rule-bright). The rule
					// is now permanent and drawn by .entry-row::before, so it needs no
					// transparent border holding a slot open against layout shift.
					// -mx-4/px-4 stays: it keeps the text aligned with the section
					// heading while letting the wash bleed past it on both sides.
					return (
						<li
							class="entry-row -mx-4 px-4 py-5"
							style={`--entry-tint: ${entryTint(index, posts.length)}`}
						>
							{/* Decorative. The wash and the bar say nothing the row does not
							    already say in text, so they are hidden rather than described. */}
							<div class="entry-row__reveal" aria-hidden="true">
								<div class="entry-row__tint" />
								<div class="entry-row__scrim entry-row__scrim--x" />
								<div class="entry-row__scrim entry-row__scrim--y" />
							</div>
							<div class="entry-row__bar" aria-hidden="true" />

							<div class="entry-row__body sm:flex sm:gap-6">
								<time
									datetime={isoDate(post.data.pubDate)}
									class="text-text-3 block shrink-0 text-[0.72rem] leading-5 sm:w-16"
								>
									{formatDayMonth(post.data.pubDate)}
									<span class="block">{post.data.pubDate.getUTCFullYear()}</span>
								</time>

								<div class="mt-1 min-w-0 sm:mt-0">
									<h3 class="font-display text-base leading-snug font-bold">
										{/* __link stretches this anchor over the whole row, so the row
										    is clickable while remaining one link with the title as its
										    accessible name. */}
										<a
											href={withBase(`/posts/${post.id}`)}
											class="entry-row__title entry-row__link text-text no-underline"
										>
											{post.data.title}
										</a>
									</h3>

									<p class="text-text-2 mt-1.5 max-w-[42ch] text-sm leading-relaxed">
										{post.data.description}
									</p>

									<div class="mt-2.5">
										<EntryMeta domain={post.data.domain} minutes={minutes} subtle />
									</div>
								</div>
							</div>
						</li>
					);
				})}
			</ol>
		)
	}
</section>
