---
import { formatDayMonth, isoDate, rowFilterData, rowTag, type Post } from '../lib/collections';
import { ENTRY_TINT } from '../lib/entryTints';
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/readingTime';
import EntryMeta from './EntryMeta.astro';
import EntryThumb from './EntryThumb.astro';

interface Props {
	posts: Post[];
	/** Heading shown above the list, e.g. "Latest". */
	label: string;
	/** Shown when there is nothing to list. */
	emptyMessage?: string;
	/**
	 * Entries behind the listing, where `posts` is one page of a larger set. The
	 * header count reads this instead of the slice, so a paginated ledger says how
	 * deep the archive is rather than reprinting SITE.pageSize on every page but
	 * the last. Two callers, both of them the ledger; see LedgerView.astro.
	 *
	 * Omit it wherever `posts` is the whole set - every unpaginated listing - where
	 * the slice is the total already and passing it would be the same number twice.
	 */
	total?: number;
	/**
	 * True on a solution archive, where every row would otherwise repeat the h1.
	 * Those rows show their primary topic instead. rowTag() applies it.
	 *
	 * A boolean rather than the `filteredBy: ListingFilter` this was, because there
	 * is one filtered listing left: the area and topic archives that union covered
	 * are gone.
	 */
	filteredBySolution?: boolean;
	/**
	 * Emit filter keys as data-* on each row and mark the count for live updating.
	 * One caller, /search, which filters these rows client-side. Off everywhere
	 * else, so no other listing pays for the duplicated description in data-text.
	 */
	filterable?: boolean;
}

const {
	posts,
	label,
	emptyMessage = 'No entries yet.',
	total,
	filteredBySolution = false,
	filterable = false,
} = Astro.props;

// Honest count, correctly pluralised. A blog with one post says "1 article".
//
// `total` when a caller passes one, so a paginated ledger counts the archive and
// not the page it is showing - see the prop above. Falls back to the slice, which
// is the whole set on every other listing, and is what /search's client-side
// rewrite recomputes from the rows it leaves visible.
const count = total ?? posts.length;
const countLabel = `${count} ${count === 1 ? 'article' : 'articles'}`;
---

<section aria-label={label}>
	<div class="border-rule flex flex-wrap items-baseline justify-between gap-2 border-b pb-3">
		<h2 class="text-blue text-[0.68rem] font-normal tracking-[0.12em] uppercase">
			{label}
		</h2>
		{
			posts.length > 0 && (
				<p
					class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase"
					data-entry-count={filterable ? '' : undefined}
				>
					{countLabel}
				</p>
			)
		}
	</div>

	{
		posts.length === 0 ? (
			<p class="text-text-2 py-10 text-sm">{emptyMessage}</p>
		) : (
			<ol>
				{/* No top margin: the first row sits flush under the heading's border-b so
				    that rule is its separator, exactly as each row's own bottom rule is the
				    separator for the row beneath it. Every row then has the same 1.25rem
				    (py-5) between the rule above it and its own copy. */}
				{posts.map((post) => {
					const minutes = readingTimeMinutes(post.body);
					const tag = rowTag(post, filteredBySolution);
					// The row is a hover reveal: a colour wash cross-fades in at 0.60
					// under two scrims, a 1px bar rises up the left edge and the copy
					// slides 10px right. Geometry and timing are in .entry-row in
					// global.css; the gradient comes from lib/entryTints.ts and is handed
					// over as --entry-tint.
					//
					// One colour on every row. This was a ramp keyed to the index and the
					// list length - indigo at the top, cyan-ish at the bottom - which
					// measured several times below a just-noticeable difference end to end
					// and so was never visible. See the note in lib/entryTints.ts. Being a
					// constant, it also settles the question /search used to raise: rows
					// hidden by a filter no longer leave gaps in anything.
					//
					// Still set per row as a custom property rather than written into
					// .entry-row__tint, so bringing variation back is a one-file change.
					//
					// This replaces the sb-blog .mini treatment that was here (ground
					// lifting to surface-2, border brightening to rule-bright). The rule
					// is now permanent and drawn by .entry-row::before, so it needs no
					// transparent border holding a slot open against layout shift.
					// -mx-4/px-4 stays: it keeps the text aligned with the section
					// heading while letting the wash bleed past it on both sides.
					return (
						<li
							class="entry-row -mx-4 px-4 py-5"
							style={`--entry-tint: ${ENTRY_TINT}`}
							{...(filterable ? rowFilterData(post) : {})}
						>
							{/* Decorative. The wash and the bar say nothing the row does not
							    already say in text, so they are hidden rather than described. */}
							<div class="entry-row__reveal" aria-hidden="true">
								<div class="entry-row__tint" />
								<div class="entry-row__scrim entry-row__scrim--x" />
								<div class="entry-row__scrim entry-row__scrim--y" />
							</div>
							<div class="entry-row__bar" aria-hidden="true" />

							<div class="entry-row__body sm:flex sm:gap-6">
								<time
									datetime={isoDate(post.data.pubDate)}
									class="text-text-3 block shrink-0 text-[0.72rem] leading-5 sm:w-16"
								>
									{formatDayMonth(post.data.pubDate)}
									<span class="block">{post.data.pubDate.getUTCFullYear()}</span>
								</time>

								{/* Third column in the row from sm up, between the date and the
								    copy. Below that breakpoint the row is stacked, so the tile
								    takes margins of its own: mt-3 off the date, mb-3 to stand off
								    the title, both dropped at sm where the flex gap takes over.
								    The copy's own mt-1 below is for the stacked case and is
								    harmless underneath these. */}
								<EntryThumb post={post} class="mt-3 mb-3 sm:mt-0 sm:mb-0" />

								<div class="mt-1 min-w-0 sm:mt-0">
									{/* No eyebrow above the title. The product was here as a caps
									    line for a while and has gone back under the title as a tag:
									    a row's job is to sell the title, and a product name set in
									    caps above it took the first line and the strongest position
									    on every row to say something most rows repeat. As a tag it
									    is still the first thing after the copy and still the only
									    link in the row besides the title. See EntryMeta.astro. */}
									<h3 class="font-display text-base leading-snug font-bold">
										{/* __link stretches this anchor over the whole row, so the row
										    is clickable with the title as its accessible name. Two tab
										    stops per row again, not one: the solution tag below is a
										    link to that product's archive and lifts itself above this
										    one to stay clickable. That is the cost of the tag being a
										    tag, and it buys the only sideways route out of a row. */}
										<a
											href={withBase(`/posts/${post.id}`)}
											class="entry-row__title entry-row__link text-text no-underline"
										>
											{post.data.title}
										</a>
									</h3>

									<p class="text-text-2 mt-1.5 max-w-[42ch] text-sm leading-relaxed">
										{post.data.description}
									</p>

									<div class="mt-2.5">
										<EntryMeta tag={tag} minutes={minutes} />
									</div>
								</div>
							</div>
						</li>
					);
				})}
			</ol>
		)
	}
</section>
