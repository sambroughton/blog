---
import type { GetStaticPaths } from 'astro';
import EntryList from '../../components/EntryList.astro';
import Sidebar from '../../components/Sidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getPublishedPosts,
	postsBySolution,
	shouldShowSidebar,
	solutionFacets,
} from '../../lib/collections';

// Only solutions with at least one published entry get a page, so neither the
// rail, the search filter nor a row's eyebrow can link to an empty listing. An
// entry names several solutions, so it can appear under more than one of these.
//
// Filtered listings are not paginated: revisit if any single solution outgrows a
// comfortable page.
export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	return solutionFacets(posts).map((facet) => ({
		params: { solution: facet.slug },
		props: {
			label: facet.label,
			posts: postsBySolution(posts, facet.slug),
			allPosts: posts,
		},
	}));
}) satisfies GetStaticPaths;

const { label, posts, allPosts } = Astro.props;
const showSidebar = shouldShowSidebar(allPosts.length);
---

{
	/* The rail carries no product list any more, which settles an argument this
	   comment has been having with itself for three revisions.

	   The original position was that the rail's facet list is the products, and
	   this page is one product, so carrying the list here would put the current
	   page in a list of options - a filter offering itself as an option. Then the
	   header menu stopped listing products, which left no route from one product
	   archive to another, so the list came into the rail with the current one
	   rendered as plain text with aria-current.

	   Both are moot. The header menu is the products again, so the sideways route
	   is back on every page including this one, and the rail is down to what is new
	   and when - neither of which repeats anything here. The rail still takes the
	   whole collection rather than this page's slice, because the recent entries
	   and the year archive are facts about the blog and not about this product.

	   Three crumbs now, not two: /solutions exists, so the middle step names a page
	   that is really there. It was two while that index did not exist, on the rule
	   that a crumb pointing nowhere is worse than a shorter trail. */
}
<BaseLayout
	title={label}
	description={`Entries on ${label}.`}
	crumbs={[{ label: 'Home', href: '/' }, { label: 'Solutions', href: '/solutions' }, { label }]}
>
	{
		/* No blurb under the heading. There is no written description of any of these
		   products anywhere in the repo, and inventing one here would be marketing
		   copy about Microsoft's product rather than anything about the work - which
		   the entries below already speak for. The count in the list header is the
		   one fact about the product this page can honestly add. */
	}
	<p class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Solution</p>
	<h1 class="font-display text-text mt-1 mb-6 text-2xl font-bold">{label}</h1>

	<div class={showSidebar ? 'grid gap-10 md:grid-cols-[1fr_15rem]' : ''}>
		<div class="min-w-0">
			{
				/* filteredBySolution: every row here shares the product in the heading
				   above, so a solution tag on each would repeat it down the page and
				   separate nothing. Those rows carry their primary topic instead, which is
				   what actually distinguishes one from the next here. See rowTag(). */
			}
			<EntryList posts={posts} label="Entries" filteredBySolution />
		</div>
		{showSidebar && <Sidebar posts={allPosts} />}
	</div>
</BaseLayout>
