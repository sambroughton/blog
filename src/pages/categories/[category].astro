---
import type { GetStaticPaths } from 'astro';
import EntryList from '../../components/EntryList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryFacets, getPublishedPosts, postsByCategory } from '../../lib/collections';

// Only categories with at least one published entry get a page, so neither the
// header menu, the sidebar nor the index can link to an empty listing. An entry
// names several categories, so it can appear under more than one of these.
//
// Filtered listings are not paginated: revisit if any single category outgrows a
// comfortable page.
export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	return categoryFacets(posts).map((facet) => ({
		params: { category: facet.slug },
		props: {
			label: facet.label,
			posts: postsByCategory(posts, facet.slug),
		},
	}));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---

{
	/* No rail on this page, unlike the ledger and the topic archives.

	   The rail's only facet list is the categories, and this page is one category.
	   Carrying it here would put the full list of them beside a listing filtered to
	   one, with the current one in it linking to the page you are already on - a
	   filter offering itself as an option. The way sideways to another category is
	   the header menu, which is on every page and does not need the width. Archive
	   years go with it, which is the smaller loss: they are a different axis and
	   reachable from the ledger.

	   No allPosts prop either, as a result, so this route also stops loading the
	   whole collection to render one facet list.

	   Two crumbs, not three, for the same reason the rail went: there is no
	   categories index to name as the middle step. The header menu is the list of
	   them, and a crumb pointing at a page that does not exist is worse than a
	   shorter trail. */
}
<BaseLayout
	title={label}
	description={`Entries on ${label}.`}
	crumbs={[{ label: 'Home', href: '/' }, { label }]}
>
	{
		/* No blurb under the heading. There is no written description of any of these
		   categories anywhere in the repo, and inventing one here would be marketing
		   copy about Microsoft's product rather than anything about the work - which
		   the entries below already speak for. */
	}
	<p class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Category</p>
	<h1 class="font-display text-text mt-1 mb-6 text-2xl font-bold">{label}</h1>

	{
		/* tag="topic": every row here shares the category in the heading above, so a
	    category tag on each would repeat it down the page and separate nothing.
	    The topic is what actually distinguishes one row from the next. */
	}
	<EntryList posts={posts} label="Entries" tag="topic" />
</BaseLayout>
