---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import EntryEyebrow from '../../components/EntryEyebrow.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, isoDate, primarySolution } from '../../lib/collections';
import { withBase } from '../../lib/paths';
import { readingTimeMinutes } from '../../lib/readingTime';
import { slugify } from '../../lib/slug';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	// Neighbours come from the same sorted list the ledger uses, so "previous"
	// means previous chronologically, not previous alphabetically.
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: index > 0 ? posts[index - 1] : undefined,
			older: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	publishedTime={post.data.pubDate}
	narrow
	crumbs={[
		{ label: 'Home', href: '/' },
		/* The primary solution, not /posts: /posts is a route prefix with no index
		   behind it, and a crumb that leads nowhere is worse than no crumb. An entry
		   can name several solutions, so this trail picks the first - the one the
		   entry is about - rather than offering a fork. Every published entry's
		   solutions have a page, since those pages are generated from the solutions
		   published entries actually use.

		   This does mean the product is named twice above the fold, once here and
		   once in the eyebrow below. That is the pattern a solution archive already
		   uses, where the value is in the crumb and in the h1 - and the breadcrumb is
		   documented as the quietest thing on the page, ranked below the metadata
		   line, so the two are not competing for the same job. The crumb navigates
		   up; the eyebrow states what the entry is about. */
		{
			label: primarySolution(post),
			href: `/solutions/${slugify(primarySolution(post))}`,
		},
		{ label: post.data.title },
	]}
>
	<article class="mx-auto max-w-2xl">
		<header>
			{
				/* The products this entry is built on, above everything else on the page.
				   Linked here, unlike on a ledger row: a row is one stretched link and a
				   second target inside it would be a second tab stop, whereas a reader who
				   has opened the entry is exactly the one who might follow the product
				   sideways to the rest of the work in it. */
			}
			<EntryEyebrow labels={post.data.solutions} />

			{
				/* The series, demoted from the accent to text-3. It used to be the only
				   caps line here and so it took the accent; the solution now sits above it
				   holding that slot, and two blue caps lines stacked would read as one
				   two-line label rather than as two different facts. Same size and
				   tracking, so it still reads as the same tier - just quieter, which is
				   also the right order of weight: three entries share a series, every entry
				   names a product. */
			}
			{
				post.data.series && (
					<p class="text-text-3 mt-1 text-[0.68rem] tracking-[0.12em] uppercase">
						{post.data.series}
					</p>
				)
			}

			<h1 class="font-display text-text mt-4 text-3xl leading-tight font-bold sm:text-4xl">
				{post.data.title}
			</h1>

			<p class="text-text-2 mt-4 max-w-[52ch] text-[1.05rem] leading-relaxed">
				{post.data.description}
			</p>

			<div class="border-rule mt-5 border-b pb-5">
				{
					/* Date and reading time only on this line. The product is not repeated
				    here: it is the eyebrow above the title, which is where this page now
				    leads with it. */
				}
				<div class="text-text-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.72rem]">
					<time datetime={isoDate(post.data.pubDate)}>
						{formatDate(post.data.pubDate)}
					</time>
					<span>{minutes} min read</span>
				</div>

				{
					/* Every topic this entry carries, uncapped - which is what separates this
				    page from a ledger row, where one tag stands for the lot. A reader who
				    has opened the entry is the one who wants to know what is in it.

				    Unlinked, as they are everywhere now. That is the loss this change
				    takes: the line used to be the way to follow a subject sideways, and
				    there is no longer anywhere for it to go. It stays as a tag run rather
				    than becoming prose because the labels are still worth scanning, and
				    because it is the shape a reader has already met on the row that brought
				    them here.

				    The hierarchy reads top to bottom - product in the eyebrow, subjects
				    down here - which is the same order a row reads and the same order the
				    search filters read. */
				}
				<div class="mt-4">
					<EntryMeta topics={post.data.topics} />
				</div>
			</div>

			{
				post.data.updatedDate && (
					<p class="text-text-3 mt-3 text-[0.72rem]">
						Updated{' '}
						<time datetime={isoDate(post.data.updatedDate)}>
							{formatDate(post.data.updatedDate)}
						</time>
					</p>
				)
			}

			{
				post.data.cover && (
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						widths={[640, 1024]}
						sizes="(min-width: 768px) 42rem, 100vw"
						class="border-rule mt-6 w-full border"
						loading="eager"
					/>
				)
			}
		</header>

		<div class="prose-body mt-8">
			<Content />
		</div>

		<nav
			aria-label="Nearby entries"
			class="border-rule mt-14 grid gap-4 border-t pt-6 sm:grid-cols-2"
		>
			{
				older ? (
					<a href={withBase(`/posts/${older.id}`)} class="group">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Older</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{older.data.title}
						</span>
					</a>
				) : (
					<span />
				)
			}

			{
				newer && (
					<a href={withBase(`/posts/${newer.id}`)} class="group sm:text-right">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Newer</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{newer.data.title}
						</span>
					</a>
				)
			}
		</nav>
	</article>
</BaseLayout>
