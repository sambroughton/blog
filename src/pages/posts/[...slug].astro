---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import EntryMeta from '../../components/EntryMeta.astro';
import { domainLabel, technologyLabel, topicLabel } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, isoDate } from '../../lib/collections';
import { withBase } from '../../lib/paths';
import { readingTimeMinutes } from '../../lib/readingTime';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	// Neighbours come from the same sorted list the ledger uses, so "previous"
	// means previous chronologically, not previous alphabetically.
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: index > 0 ? posts[index - 1] : undefined,
			older: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	publishedTime={post.data.pubDate}
	narrow
	crumbs={[
		{ label: 'Home', href: '/' },
		/* The domain, not /posts: an entry has exactly one domain, so it is the only
		   step that is genuinely above this page. /posts is a route prefix with no
		   index behind it, and a crumb that leads nowhere is worse than no crumb.
		   Every published entry's domain has a page, since those pages are generated
		   from the domains that published entries actually use. */
		{ label: domainLabel(post.data.domain), href: `/domains/${post.data.domain}` },
		{ label: post.data.title },
	]}
>
	<article class="mx-auto max-w-2xl">
		<header>
			{
				post.data.series && (
					<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">{post.data.series}</p>
				)
			}

			<h1 class="font-display text-text mt-4 text-3xl leading-tight font-bold sm:text-4xl">
				{post.data.title}
			</h1>

			<p class="text-text-2 mt-4 max-w-[52ch] text-[1.05rem] leading-relaxed">
				{post.data.description}
			</p>

			<div class="border-rule mt-5 border-b pb-5">
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
					<time datetime={isoDate(post.data.pubDate)} class="text-text-3 text-[0.72rem]">
						{formatDate(post.data.pubDate)}
					</time>
					<EntryMeta domain={post.data.domain} minutes={minutes} />
				</div>

				{
					/* The richer taxonomy belongs here rather than in the listing: a row in a
				    list needs only the discipline, but a reader who has opened the entry
				    is the one who might follow a specific subject or product sideways.
				    A description list, since each row is a name and its values. */
				}
				<dl class="mt-4 grid gap-y-1.5 text-[0.72rem]">
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<dt class="text-text-3 w-24 shrink-0 text-[0.63rem] tracking-[0.12em] uppercase">
							Topics
						</dt>
						<dd class="flex flex-wrap gap-x-3 gap-y-1">
							{
								post.data.topics.map((topic) => (
									<a
										href={withBase(`/topics/${topic}`)}
										class="text-text-2 hover:text-blue transition-colors"
									>
										{topicLabel(topic)}
									</a>
								))
							}
						</dd>
					</div>

					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<dt class="text-text-3 w-24 shrink-0 text-[0.63rem] tracking-[0.12em] uppercase">
							Technologies
						</dt>
						<dd class="flex flex-wrap gap-x-3 gap-y-1">
							{
								post.data.technologies.map((technology) => (
									<a
										href={withBase(`/technologies/${technology}`)}
										class="text-text-2 hover:text-blue transition-colors"
									>
										{technologyLabel(technology)}
									</a>
								))
							}
						</dd>
					</div>
				</dl>
			</div>

			{
				post.data.updatedDate && (
					<p class="text-text-3 mt-3 text-[0.72rem]">
						Updated{' '}
						<time datetime={isoDate(post.data.updatedDate)}>
							{formatDate(post.data.updatedDate)}
						</time>
					</p>
				)
			}

			{
				post.data.cover && (
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						widths={[640, 1024]}
						sizes="(min-width: 768px) 42rem, 100vw"
						class="border-rule mt-6 w-full border"
						loading="eager"
					/>
				)
			}
		</header>

		<div class="prose-body mt-8">
			<Content />
		</div>

		<nav
			aria-label="Nearby entries"
			class="border-rule mt-14 grid gap-4 border-t pt-6 sm:grid-cols-2"
		>
			{
				older ? (
					<a href={withBase(`/posts/${older.id}`)} class="group">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Older</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{older.data.title}
						</span>
					</a>
				) : (
					<span />
				)
			}

			{
				newer && (
					<a href={withBase(`/posts/${newer.id}`)} class="group sm:text-right">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Newer</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{newer.data.title}
						</span>
					</a>
				)
			}
		</nav>
	</article>
</BaseLayout>
