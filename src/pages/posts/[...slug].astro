---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import EntryMeta from '../../components/EntryMeta.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, isoDate } from '../../lib/collections';
import { withBase } from '../../lib/paths';
import { readingTimeMinutes } from '../../lib/readingTime';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	// Neighbours come from the same sorted list the ledger uses, so "previous"
	// means previous chronologically, not previous alphabetically.
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: index > 0 ? posts[index - 1] : undefined,
			older: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	publishedTime={post.data.pubDate}
>
	<article class="mx-auto max-w-2xl">
		<header>
			{
				post.data.series && (
					<p class="font-mono text-[0.62rem] tracking-[0.16em] text-amber-700 uppercase dark:text-amber-500">
						{post.data.series}
					</p>
				)
			}

			<h1
				class="font-display text-navy-900 dark:text-paper mt-2 text-3xl leading-tight sm:text-4xl"
			>
				{post.data.title}
			</h1>

			<p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
				{post.data.description}
			</p>

			<div
				class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-slate-200 pb-5 dark:border-slate-800"
			>
				<time
					datetime={isoDate(post.data.pubDate)}
					class="font-mono text-[0.68rem] text-slate-500 dark:text-slate-400"
				>
					{formatDate(post.data.pubDate)}
				</time>
				<EntryMeta topic={post.data.topic} minutes={minutes} />
			</div>

			{
				post.data.updatedDate && (
					<p class="mt-3 font-mono text-[0.68rem] text-slate-500 dark:text-slate-400">
						Updated{' '}
						<time datetime={isoDate(post.data.updatedDate)}>
							{formatDate(post.data.updatedDate)}
						</time>
					</p>
				)
			}

			{
				post.data.cover && (
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						widths={[640, 1024]}
						sizes="(min-width: 768px) 42rem, 100vw"
						class="mt-6 w-full rounded-md"
						loading="eager"
					/>
				)
			}
		</header>

		<div class="prose-body text-ink mt-8 dark:text-slate-300">
			<Content />
		</div>

		<nav
			aria-label="Nearby entries"
			class="mt-14 grid gap-4 border-t border-slate-200 pt-6 sm:grid-cols-2 dark:border-slate-800"
		>
			{
				older ? (
					<a href={withBase(`/posts/${older.id}`)} class="group">
						<span class="font-mono text-[0.62rem] tracking-wider text-slate-400 uppercase dark:text-slate-500">
							Older
						</span>
						<span class="font-display text-navy-800 mt-1 block text-base group-hover:text-amber-700 dark:text-slate-200 dark:group-hover:text-amber-400">
							{older.data.title}
						</span>
					</a>
				) : (
					<span />
				)
			}

			{
				newer && (
					<a href={withBase(`/posts/${newer.id}`)} class="group sm:text-right">
						<span class="font-mono text-[0.62rem] tracking-wider text-slate-400 uppercase dark:text-slate-500">
							Newer
						</span>
						<span class="font-display text-navy-800 mt-1 block text-base group-hover:text-amber-700 dark:text-slate-200 dark:group-hover:text-amber-400">
							{newer.data.title}
						</span>
					</a>
				)
			}
		</nav>
	</article>
</BaseLayout>
