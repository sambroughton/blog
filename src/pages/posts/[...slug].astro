---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import CategoryTag from '../../components/CategoryTag.astro';
import TopicLink from '../../components/TopicLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, isoDate, primaryCategory } from '../../lib/collections';
import { withBase } from '../../lib/paths';
import { readingTimeMinutes } from '../../lib/readingTime';
import { slugify } from '../../lib/slug';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	// Neighbours come from the same sorted list the ledger uses, so "previous"
	// means previous chronologically, not previous alphabetically.
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: index > 0 ? posts[index - 1] : undefined,
			older: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
	publishedTime={post.data.pubDate}
	narrow
	crumbs={[
		{ label: 'Home', href: '/' },
		/* The primary category, not /posts: /posts is a route prefix with no index
		   behind it, and a crumb that leads nowhere is worse than no crumb. An entry
		   can name several categories, so this trail picks the first - the one the
		   entry is about - rather than offering a fork. Every published entry's
		   categories have a page, since those pages are generated from the categories
		   published entries actually use. */
		{
			label: primaryCategory(post),
			href: `/categories/${slugify(primaryCategory(post))}`,
		},
		{ label: post.data.title },
	]}
>
	<article class="mx-auto max-w-2xl">
		<header>
			{
				post.data.series && (
					<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">{post.data.series}</p>
				)
			}

			<h1 class="font-display text-text mt-4 text-3xl leading-tight font-bold sm:text-4xl">
				{post.data.title}
			</h1>

			<p class="text-text-2 mt-4 max-w-[52ch] text-[1.05rem] leading-relaxed">
				{post.data.description}
			</p>

			<div class="border-rule mt-5 border-b pb-5">
				{
					/* Date and reading time only on this line. The category is not repeated
				    here the way it is on a ledger row: it sits in the list below with the
				    topics, where the two vocabularies can be read against each other. */
				}
				<div class="text-text-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.72rem]">
					<time datetime={isoDate(post.data.pubDate)}>
						{formatDate(post.data.pubDate)}
					</time>
					<span>{minutes} min</span>
				</div>

				{
					/* Both vocabularies in full, which is what separates this page from a
				    ledger row: a row shows the primary category alone, but a reader who
				    has opened the entry is the one who might follow a specific subject or
				    product sideways. A description list, since each row is a name and its
				    values.

				    Categories first and tagged, topics second and plainer, which is the
				    same order of weight the rest of the site gives them. */
				}
				<dl class="mt-4 grid gap-y-2 text-[0.72rem]">
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
						<dt class="text-text-3 w-24 shrink-0 text-[0.63rem] tracking-[0.12em] uppercase">
							Categories
						</dt>
						<dd class="flex flex-wrap gap-1.5">
							{post.data.categories.map((category) => <CategoryTag label={category} />)}
						</dd>
					</div>

					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
						<dt class="text-text-3 w-24 shrink-0 text-[0.63rem] tracking-[0.12em] uppercase">
							Topics
						</dt>
						<dd class="flex flex-wrap gap-1.5">
							{post.data.topics.map((topic) => <TopicLink label={topic} />)}
						</dd>
					</div>
				</dl>
			</div>

			{
				post.data.updatedDate && (
					<p class="text-text-3 mt-3 text-[0.72rem]">
						Updated{' '}
						<time datetime={isoDate(post.data.updatedDate)}>
							{formatDate(post.data.updatedDate)}
						</time>
					</p>
				)
			}

			{
				post.data.cover && (
					<Image
						src={post.data.cover}
						alt={post.data.coverAlt ?? ''}
						widths={[640, 1024]}
						sizes="(min-width: 768px) 42rem, 100vw"
						class="border-rule mt-6 w-full border"
						loading="eager"
					/>
				)
			}
		</header>

		<div class="prose-body mt-8">
			<Content />
		</div>

		<nav
			aria-label="Nearby entries"
			class="border-rule mt-14 grid gap-4 border-t pt-6 sm:grid-cols-2"
		>
			{
				older ? (
					<a href={withBase(`/posts/${older.id}`)} class="group">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Older</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{older.data.title}
						</span>
					</a>
				) : (
					<span />
				)
			}

			{
				newer && (
					<a href={withBase(`/posts/${newer.id}`)} class="group sm:text-right">
						<span class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Newer</span>
						<span class="font-display text-text-2 group-hover:text-blue mt-1 block text-base font-bold transition-colors">
							{newer.data.title}
						</span>
					</a>
				)
			}
		</nav>
	</article>
</BaseLayout>
