---
import EntryList from '../components/EntryList.astro';
import FilterSelect from '../components/FilterSelect.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, solutionFacets, topicFacets } from '../lib/collections';

// Every published entry, rendered as an ordinary ledger row, then filtered in the
// browser by hiding rows that do not match.
//
// The alternative was a JSON index and rows built in JavaScript, and this is
// better for one reason that outweighs the rest: there is exactly one piece of row
// markup on this site and it stays in EntryList.astro. A client-side renderer would
// be a second copy of it, free to drift, and it would put the entire listing behind
// scripting. Here the page is a complete, crawlable, readable archive before any
// script runs, and the script only ever sets the `hidden` attribute.
//
// `hidden` rather than a class: it takes a row out of the accessibility tree and
// the tab order as well as off the screen, for free, which a display rule would
// not. Nothing sets `display` on .entry-row, so the user-agent rule wins.
//
// The two filters are the site's two vocabularies: Solution, then Topic. The Area
// select between them has gone with the group layer it was built from. Each option
// list comes from the same facet helper the listings are built from, so a filter
// can only offer a value that has entries behind it, and the option values are
// slugs to match the data attributes rowFilterData() writes.
//
// Neither is a <select> any more. They were, and the closed box already looked
// right, but a native option list is painted by the browser and cannot be styled
// at all - so the part of the control a reader is looking at while they use it was
// the part that did not belong to this site. <FilterSelect> is that list drawn as
// the header's dropdown panel; the reasoning and the cost of the swap are at the
// top of that file. What did not change is the shape of the data: a facet still
// carries its current slug on the element the script finds by data-search-facet,
// and still fires `change` when it moves.
//
// The Topic select is now the only control on the site that acts on a topic.
// Topics are not linked anywhere any more - see the note on TOPICS in consts.ts -
// and that makes this page more important rather than less: it is where the
// subject vocabulary is still usable, and the reason removing the topic archives
// did not strand it. Worth keeping in mind if this page is ever trimmed.
//
// Scale: this ships every published entry's title, description and a lowercased
// copy of both, at roughly 1.5 KB of HTML per row. Fine into the low hundreds;
// worth revisiting past about 150 entries, where the first thing to change is the
// row payload - drop data-text and build the haystack in the script at init -
// rather than the approach.
const posts = await getPublishedPosts();

const solutions = solutionFacets(posts);
const topics = topicFacets(posts);

// Shared by all three labels, so the controls cannot drift apart. It is why the
// two pickers' labels stayed on this page rather than moving into FilterSelect:
// the text input is a native <input> and will never live in that component, so
// the only place the three can be stated once is here.
const field = 'text-text-3 block text-[0.63rem] tracking-[0.12em] uppercase';
---

<BaseLayout
	title="Search"
	description="Filter the entries by Microsoft product, topic or text."
	crumbs={[{ label: 'Home', href: '/' }, { label: 'Search' }]}
>
	<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">Browse</p>
	<h1 class="font-display text-text mt-1 text-2xl leading-tight font-bold sm:text-3xl">Search</h1>
	<p class="text-text-2 mt-3 max-w-[52ch] text-sm leading-relaxed">
		Filter by the product an entry is built on, the subject it covers, or the words in its title and
		summary.
	</p>

	{
		/* role="search" and not a <form>. There is nothing to submit to on a static
		   site, so a form would promise a round trip the page cannot make and would
		   put a surprise on the Enter key. The landmark is what a screen reader
		   actually wants here, and role gives it without the element. */
	}
	<div
		role="search"
		aria-label="Filter entries"
		class="search-filters border-rule mt-8 border-t pt-6"
		data-search
	>
		<div>
			<label for="search-q" class={field}>Search articles</label>
			<input
				type="search"
				id="search-q"
				class="search-input mt-1.5"
				placeholder="Title or summary…"
				autocomplete="off"
				data-search-text
			/>
		</div>

		{
			/* Two columns from sm up, one below. The pickers are equal-width rather
			   than sized to their content: the option lists are wildly different lengths
			   and a row of differently sized boxes reads as unrelated controls.

			   The labels stay out here, sharing `field` with the input's above, which is
			   the whole reason FilterSelect takes an id to point at rather than rendering
			   a label of its own. A <span> and not a <label>: `for` only binds to a
			   labelable element and the control is a div carrying role="combobox", so a
			   <label> here would be markup that looks like it does something and does
			   not. The binding is the aria-labelledby inside the component. */
		}
		<div class="mt-4 grid gap-3 sm:grid-cols-2">
			<div>
				<span id="search-solution-label" class={field}>Solution</span>
				<FilterSelect
					id="search-solution"
					labelledBy="search-solution-label"
					facet="solutions"
					allLabel="All solutions"
					options={solutions.map((facet) => ({ value: facet.slug, label: facet.label }))}
					class="mt-1.5"
				/>
			</div>

			<div>
				<span id="search-topic-label" class={field}>Topic</span>
				<FilterSelect
					id="search-topic"
					labelledBy="search-topic-label"
					facet="topics"
					allLabel="All topics"
					options={topics.map((facet) => ({ value: facet.slug, label: facet.label }))}
					class="mt-1.5"
				/>
			</div>
		</div>
	</div>

	<noscript>
		{
			/* is:inline so this stays in the document rather than being hoisted into the
			   global stylesheet, which would hide the controls for everyone. Hiding the
			   whole panel rather than leaving three inert controls on the page: the same
			   call SiteHeader's noscript makes about its dropdown, for the same reason -
			   a control that does nothing is worse than no control, and showing the list
			   itself is the honest answer. The count below is correct without scripting,
			   since it is the real total.

			   This rule is now load-bearing for the two pickers rather than merely tidy.
			   A <select> with no script behind it is inert but still legible - it opens,
			   it shows the vocabulary. FilterSelect is a div that does nothing at all
			   until its script runs, so hiding it is what stops it rendering as a box
			   with a caret that never opens. Worth knowing before this rule is relaxed. */
		}
		<style is:inline>
			.search-filters {
				display: none;
			}
		</style>
		<p class="text-text-2 border-rule mt-8 border-t pt-6 text-sm">
			Filtering needs JavaScript. Every entry is listed below, newest first.
		</p>
	</noscript>

	<div class="mt-10">
		<EntryList posts={posts} label="Results" filterable />

		{
			/* Not a live region. The count above is the announcement - it is marked
			   aria-live by the script - and two regions firing on one keystroke would
			   say the same thing twice. EntryList's own empty branch cannot fire here,
			   since the collection is never empty on this page; these are its exact
			   classes so the two states are indistinguishable. */
		}
		<p hidden class="text-text-2 py-10 text-sm" data-search-empty>
			No entries match these filters.
		</p>
	</div>
</BaseLayout>

<script>
	// Filtering is attribute matching, nothing more. Each row carries its taxonomy
	// as space-separated slugs and its searchable text pre-lowercased, written by
	// rowFilterData() at build time - see lib/collections.ts for why the slugs are
	// space-separated rather than concatenated.
	const root = document.querySelector<HTMLElement>('[data-search]');
	const count = document.querySelector<HTMLElement>('[data-entry-count]');
	// The list section is found through the count rather than by a selector of its
	// own, so the two can never end up pointing at different listings.
	const list = count?.closest('section') ?? null;
	const empty = document.querySelector<HTMLElement>('[data-search-empty]');

	if (root && count && list) {
		const text = root.querySelector<HTMLInputElement>('[data-search-text]');
		// Plain elements rather than the HTMLSelectElements these were: a facet's
		// current slug is on its wrapper as data-value now, written by
		// FilterSelect's script when a row is chosen. Same one-value-per-facet
		// contract, read off an attribute instead of off `.value`.
		const facets = [...root.querySelectorAll<HTMLElement>('[data-search-facet]')];
		const rows = [...list.querySelectorAll<HTMLElement>('li.entry-row')];

		// Applied here rather than in the markup, so with scripting off nothing
		// promises updates it cannot deliver. Same approach SiteHeader takes with the
		// dropdown's menu semantics.
		count.setAttribute('aria-live', 'polite');
		count.setAttribute('aria-atomic', 'true');

		/** Exact whole-value match against one of a row's space-separated slug lists. */
		const has = (row: HTMLElement, key: string, value: string) =>
			!value || (row.dataset[key] ?? '').split(' ').includes(value);

		// Arrow consts rather than function declarations, and not a style preference:
		// a declaration is hoisted, so the compiler cannot prove it only runs after the
		// null guard above and drops the narrowing on `count` inside it. A const is
		// created after the guard, so the narrowing survives without an assertion.
		const apply = () => {
			const query = (text?.value ?? '').trim().toLowerCase();
			let shown = 0;

			for (const row of rows) {
				const matches =
					(!query || (row.dataset.text ?? '').includes(query)) &&
					facets.every((facet) =>
						has(row, facet.dataset.searchFacet ?? '', facet.dataset.value ?? ''),
					);

				row.hidden = !matches;
				if (matches) shown++;
			}

			// Rebuilds the string EntryList renders, with the same pluralisation, so the
			// filtered count and the build-time one cannot read differently.
			count.textContent = `${shown} ${shown === 1 ? 'article' : 'articles'}`;
			if (empty) empty.hidden = shown > 0;
		};

		// No debounce. This is a substring test over a few dozen rows, so it is
		// sub-millisecond, and `polite` is what makes per-keystroke announcements
		// tolerable - assistive tech coalesces polite updates and settles once typing
		// pauses, which a debounce would only delay.
		text?.addEventListener('input', apply);

		// One listener on the panel rather than one per facet: FilterSelect fires a
		// bubbling `change` from its wrapper, which is the event a <select> in the
		// same position fired and is why this line reads as it did. The search input
		// inside `root` fires `change` on blur too and lands here - a second run of a
		// pure function over the same state, so it is left alone rather than filtered
		// out by target.
		root.addEventListener('change', apply);
	}
</script>
