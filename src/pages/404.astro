---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// GitHub Pages serves this for unmatched paths under the project's base path.
---

<BaseLayout title="Not found" description="That page does not exist.">
	<div class="mx-auto max-w-2xl py-16 text-center">
		<p
			class="font-mono text-[0.62rem] tracking-[0.16em] text-amber-700 uppercase dark:text-amber-500"
		>
			404
		</p>
		<h1 class="font-display text-navy-900 dark:text-paper mt-3 text-3xl">Nothing filed here</h1>
		<p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
			That entry either moved or never existed.
		</p>
		<a
			href={withBase('/')}
			class="mt-6 inline-block font-mono text-xs text-teal-700 underline underline-offset-4 hover:text-amber-700 dark:text-teal-400 dark:hover:text-amber-400"
		>
			Back to the ledger
		</a>
	</div>
</BaseLayout>
