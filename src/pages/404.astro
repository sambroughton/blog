---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

// GitHub Pages serves this for unmatched paths under the project's base path.
---

<BaseLayout title="Not found" description="That page does not exist.">
	<div class="mx-auto max-w-2xl py-16 text-center">
		<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">404</p>
		<h1 class="font-display text-text mt-3 text-3xl font-bold">Nothing filed here</h1>
		<p class="text-text-2 mt-3 text-sm">That entry either moved or never existed.</p>
		<a
			href={withBase('/')}
			class="text-blue hover:text-text mt-6 inline-block text-xs underline underline-offset-4 transition-colors"
		>
			Back to the ledger
		</a>
	</div>
</BaseLayout>
