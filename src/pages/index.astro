---
import LedgerView from '../components/LedgerView.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, selectHeroPosts } from '../lib/collections';

// Page 1 is a static route rather than part of the paginated one, so the
// homepage exists even when the collection is empty.
const posts = await getPublishedPosts();
const pagePosts = posts.slice(0, SITE.pageSize);
const lastPage = Math.max(1, Math.ceil(posts.length / SITE.pageSize));
const heroPosts = selectHeroPosts(posts);
---

<BaseLayout>
	{
		posts.length === 0 ? (
			<section class="bg-surface border-rule mb-12 border p-8">
				<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">Getting started</p>
				<h1 class="font-display text-text mt-4 text-2xl leading-tight font-bold sm:text-3xl">
					{SITE.tagline}
				</h1>
				<p class="text-text-2 mt-3 max-w-[44ch] text-sm leading-relaxed">
					Nothing published yet. Add a markdown file to{' '}
					<code class="bg-surface-2 border-rule border px-1 font-mono text-[#a8c8ff]">
						src/content/blog/
					</code>{' '}
					and it will appear here.
				</p>
			</section>
		) : (
			<LedgerView
				pagePosts={pagePosts}
				allPosts={posts}
				heroPosts={heroPosts}
				currentPage={1}
				lastPage={lastPage}
			/>
		)
	}
</BaseLayout>
