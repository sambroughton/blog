---
import LedgerView from '../components/LedgerView.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, selectHeroPosts } from '../lib/collections';

// Page 1 is a static route rather than part of the paginated one, so the
// homepage exists even when the collection is empty.
const posts = await getPublishedPosts();
const pagePosts = posts.slice(0, SITE.pageSize);
const lastPage = Math.max(1, Math.ceil(posts.length / SITE.pageSize));
const heroPosts = selectHeroPosts(posts);
---

<BaseLayout>
	{
		posts.length === 0 ? (
			<section class="bg-navy-900 dark:bg-navy-800 mb-12 rounded-md p-8">
				<p class="font-mono text-[0.62rem] tracking-[0.16em] text-amber-400 uppercase">
					Getting started
				</p>
				<h1 class="font-display text-paper mt-4 text-2xl leading-tight sm:text-3xl">
					{SITE.tagline}
				</h1>
				<p class="mt-3 max-w-prose text-sm leading-relaxed text-slate-300">
					Nothing published yet. Add a markdown file to{' '}
					<code class="font-mono text-teal-300">src/content/blog/</code> and it will appear here.
				</p>
			</section>
		) : (
			<LedgerView
				pagePosts={pagePosts}
				allPosts={posts}
				heroPosts={heroPosts}
				currentPage={1}
				lastPage={lastPage}
			/>
		)
	}
</BaseLayout>
