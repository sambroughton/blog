---
import LedgerView from '../components/LedgerView.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postsExcludingProjects, selectHeroPosts } from '../lib/collections';

// Page 1 is a static route rather than part of the paginated one, so the
// homepage exists even when the collection is empty.
//
// Two lists, and the difference between them is the whole of this page's layout.
// `articles` is the ledger and the hero: everything that is not a project. `posts`
// is the complete set and goes to the rail, which is where the projects surface -
// see the Recent Projects block in Sidebar.astro. Handing the rail the filtered
// list instead would leave that block permanently empty, which is the mistake this
// split is easiest to make.
//
// The hero reads from `articles` as well, so a project marked `featured` does not
// climb back onto the front page through the carousel. Nothing is featured that
// way today, so this is closing the door rather than fixing a bug.
const posts = await getPublishedPosts();
const articles = postsExcludingProjects(posts);

const pagePosts = articles.slice(0, SITE.pageSize);
const lastPage = Math.max(1, Math.ceil(articles.length / SITE.pageSize));
const heroPosts = selectHeroPosts(articles);
---

<BaseLayout>
	{
		posts.length === 0 ? (
			<section class="bg-surface border-rule mb-12 border p-8">
				<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">Getting started</p>
				<h1 class="font-display text-text mt-4 text-2xl leading-tight font-bold sm:text-3xl">
					{SITE.tagline}
				</h1>
				<p class="text-text-2 mt-3 max-w-[44ch] text-sm leading-relaxed">
					Nothing published yet. Add a markdown file to{' '}
					<code class="bg-surface-2 border-rule border px-1 font-mono text-[#a8c8ff]">
						src/content/blog/
					</code>{' '}
					and it will appear here.
				</p>
			</section>
		) : (
			<LedgerView
				pagePosts={pagePosts}
				allPosts={posts}
				heroPosts={heroPosts}
				currentPage={1}
				lastPage={lastPage}
				emptyMessage="Nothing here yet - everything published so far is a project."
			/>
		)
	}
</BaseLayout>
