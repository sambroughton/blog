---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, topicFacets } from '../../lib/collections';
import { withBase } from '../../lib/paths';

const posts = await getPublishedPosts();
const topics = topicFacets(posts);
---

{
	/* The full domain browser. The sidebar's Domains block is the quick filter
    counterpart; this page is the complete index behind it. */
}
<BaseLayout title="Topics" description="Browse entries by domain.">
	<h1 class="font-display text-text text-2xl font-bold">Topics</h1>
	<p class="text-text-2 mt-1.5 max-w-[52ch] text-sm">
		Every entry belongs to exactly one domain. These are the domains with something published behind
		them.
	</p>

	{
		topics.length === 0 ? (
			<p class="text-text-2 mt-10 text-sm">No entries yet, so there is nothing to browse.</p>
		) : (
			<section class="mt-10">
				<ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
					{topics.map((topic) => (
						<li class="border-rule flex items-baseline justify-between gap-3 border-b py-1.5">
							<a
								href={withBase(`/topics/${topic.id}`)}
								class="text-text-2 hover:text-blue transition-colors"
							>
								{topic.label}
							</a>
							<span class="text-blue text-xs">{topic.count}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</BaseLayout>
