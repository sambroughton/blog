---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, topicFacets } from '../../lib/collections';
import { withBase } from '../../lib/paths';

// A flat index of the subjects covered so far.
//
// This page previously grouped topics under a parent domain. Domains are gone
// from the information architecture, and regrouping these under categories instead
// would be wrong rather than merely different: a topic like KQL turns up under
// Sentinel and Defender XDR both, so it would have to be listed twice, and the
// grouping would imply a hierarchy the data does not have.
//
// Flat and alphabetical is also the right shape for how this page is used. It is
// looked at by someone checking whether a specific subject has been covered, not
// browsed for a progression - which is what the categories index is for.
const posts = await getPublishedPosts();
const topics = topicFacets(posts);
---

<BaseLayout
	title="Topics"
	description="The technical subjects covered so far."
	crumbs={[{ label: 'Home', href: '/' }, { label: 'Topics' }]}
>
	<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">Browse</p>
	<h1 class="font-display text-text mt-1 text-2xl leading-tight font-bold sm:text-3xl">Topics</h1>
	<p class="text-text-2 mt-3 max-w-[52ch] text-sm leading-relaxed">
		The specific subjects these entries cover, within the categories they sit in.
	</p>

	{
		topics.length === 0 ? (
			<p class="text-text-2 mt-10 text-sm">No entries yet, so there is nothing to browse.</p>
		) : (
			/* Three columns on a wide screen, two at sm, one below that. The grid cell
			   is a single topic here rather than a whole group, so the list flows down
			   the columns as one alphabetical run and the reader's eye does not have to
			   restart at each heading - there are no headings any more. */
			<ul class="border-rule mt-8 grid border-t sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3">
				{topics.map((topic) => (
					<li class="border-rule border-b">
						<a
							href={withBase(`/topics/${topic.slug}`)}
							class="text-text-2 hover:text-text flex items-baseline justify-between gap-3 py-2 text-sm transition-colors"
						>
							<span>{topic.label}</span>
							<span class="text-blue shrink-0 text-[0.72rem] tabular-nums">{topic.count}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
