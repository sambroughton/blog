---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, topicFacets } from '../../lib/collections';
import { withBase } from '../../lib/paths';

const posts = await getPublishedPosts();
const topics = topicFacets(posts);
---

<BaseLayout title="Topics" description="Browse entries by subject area.">
	<h1 class="font-display text-text text-2xl font-bold">Topics</h1>
	<p class="text-text-2 mt-1.5 max-w-[52ch] text-sm">
		Every entry has one subject area. Browse them here.
	</p>

	{
		topics.length === 0 ? (
			<p class="text-text-2 mt-10 font-mono text-sm">
				No entries yet, so there is nothing to browse.
			</p>
		) : (
			<section class="mt-10">
				<ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
					{topics.map((topic) => (
						<li class="border-rule flex items-baseline justify-between gap-3 border-b py-1.5">
							<a
								href={withBase(`/topics/${topic.id}`)}
								class="text-text-2 hover:text-blue transition-colors"
							>
								{topic.label}
							</a>
							<span class="text-blue font-mono text-xs">{topic.count}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</BaseLayout>
