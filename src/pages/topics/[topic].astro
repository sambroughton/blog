---
import type { GetStaticPaths } from 'astro';
import EntryList from '../../components/EntryList.astro';
import Sidebar from '../../components/Sidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getPublishedPosts,
	postsByTopic,
	shouldShowSidebar,
	topicFacets,
} from '../../lib/collections';

// Only topics with at least one published entry get a page, so the topics index
// can never link to an empty listing. An entry carries several topics, so it can
// appear under more than one of these.
export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	return topicFacets(posts).map((facet) => ({
		params: { topic: facet.slug },
		props: {
			label: facet.label,
			posts: postsByTopic(posts, facet.slug),
			allPosts: posts,
		},
	}));
}) satisfies GetStaticPaths;

const { label, posts, allPosts } = Astro.props;
const showSidebar = shouldShowSidebar(allPosts.length);
---

<BaseLayout
	title={label}
	description={`Entries on ${label}.`}
	crumbs={[{ label: 'Home', href: '/' }, { label: 'Topics', href: '/topics' }, { label }]}
>
	<p class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Topic</p>
	<h1 class="font-display text-text mt-1 mb-6 text-2xl font-bold">{label}</h1>

	<div class={showSidebar ? 'grid gap-10 md:grid-cols-[1fr_15rem]' : ''}>
		<div class="min-w-0">
			<EntryList posts={posts} label="Entries" />
		</div>
		{showSidebar && <Sidebar posts={allPosts} />}
	</div>
</BaseLayout>
