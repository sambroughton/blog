---
import type { GetStaticPaths } from 'astro';
import EntryList from '../../components/EntryList.astro';
import Sidebar from '../../components/Sidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { domainFacets, getPublishedPosts, shouldShowSidebar } from '../../lib/collections';

// Only domains that actually have entries get a page, so the sidebar can never
// link to an empty listing. Filtered listings are not paginated: revisit if any
// single domain outgrows a comfortable page.
export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	return domainFacets(posts).map((facet) => ({
		params: { domain: facet.id },
		props: {
			label: facet.label,
			posts: posts.filter((post) => post.data.domain === facet.id),
			allPosts: posts,
		},
	}));
}) satisfies GetStaticPaths;

const { label, posts, allPosts } = Astro.props;
const showSidebar = shouldShowSidebar(allPosts.length);
---

{
	/* Two steps, not three: there is no domain index route to sit between home and
	   a single domain, and the eyebrow above the heading already says "Domain". */
}
<BaseLayout
	title={label}
	description={`Entries in ${label}.`}
	crumbs={[{ label: 'Home', href: '/' }, { label }]}
>
	<p class="text-text-3 text-[0.68rem] tracking-[0.12em] uppercase">Domain</p>
	<h1 class="font-display text-text mt-1 mb-6 text-2xl font-bold">{label}</h1>

	<div class={showSidebar ? 'grid gap-10 md:grid-cols-[1fr_15rem]' : ''}>
		<div class="min-w-0">
			<EntryList posts={posts} label="Entries" />
		</div>
		{showSidebar && <Sidebar posts={allPosts} />}
	</div>
</BaseLayout>
