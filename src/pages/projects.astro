---
import EntryList from '../components/EntryList.astro';
import Sidebar from '../components/Sidebar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postsInProjects, shouldShowSidebar } from '../lib/collections';

// The entries carrying the Projects topic.
//
// A fixed route rather than a generated one, and the only topic on the site with a
// page at all. That asymmetry is deliberate: topics are labels rather than
// destinations - see the note on TOPICS in consts.ts - and this is the one that
// answers a question a reader actually arrives with. "Show me what you have built"
// is a different request from "show me everything about Conditional Access", and it
// is worth a page where the latter was not worth eighteen.
//
// It is a topic and not a second collection or a `project: true` flag, so an entry
// declares itself a project the same way it declares everything else, in `topics`,
// with the same enum guarding the same typo. Nothing about the entry changes -
// these are ordinary blog entries and they still appear in the ledger, the year
// archives and their products' listings.
//
// Not paginated, for the same reason the solution archives are not: revisit if
// this outgrows a comfortable page.
const posts = await getPublishedPosts();
const projects = postsInProjects(posts);

// The rail is keyed to the whole catalogue rather than to this slice: it carries
// the recent entries and the year archive, both of which are facts about the blog
// and not about this listing. Its threshold reads the same total for that reason -
// a rail is worth showing here whenever it is worth showing anywhere.
const showSidebar = shouldShowSidebar(posts.length);
---

<BaseLayout
	title="Projects"
	description="Write-ups of things I've built."
	crumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }]}
>
	<p class="text-blue text-[0.68rem] tracking-[0.12em] uppercase">Browse</p>
	<h1 class="font-display text-text mt-1 text-2xl leading-tight font-bold sm:text-3xl">Projects</h1>
	<p class="text-text-2 mt-3 max-w-[52ch] text-sm leading-relaxed">
		Things I've built, documented end to end.
	</p>

	<div class={showSidebar ? 'mt-10 grid gap-10 md:grid-cols-[1fr_15rem]' : 'mt-10'}>
		<div class="min-w-0">
			{
				/* Rows lead with their product, as they do on the ledger: this page is one
				   topic, not one solution, so nothing here repeats what the h1 has said and
				   the product is still the useful thing to show. Hence no filteredBySolution.

				   The empty message is written for a tag nothing carries yet rather than for
				   an empty blog, which is the state this page is actually in until entries
				   start declaring themselves. */
			}
			<EntryList
				posts={projects}
				label="Projects"
				emptyMessage="Nothing tagged as a project yet."
			/>
		</div>
		{showSidebar && <Sidebar posts={posts} />}
	</div>
</BaseLayout>
