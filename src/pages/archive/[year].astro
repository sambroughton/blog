---
import type { GetStaticPaths } from 'astro';
import EntryList from '../../components/EntryList.astro';
import Sidebar from '../../components/Sidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archiveYears, getPublishedPosts, shouldShowSidebar } from '../../lib/collections';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	return archiveYears(posts).map(({ year }) => ({
		params: { year: String(year) },
		props: {
			year,
			posts: posts.filter((post) => post.data.pubDate.getUTCFullYear() === year),
			allPosts: posts,
		},
	}));
}) satisfies GetStaticPaths;

const { year, posts, allPosts } = Astro.props;
const showSidebar = shouldShowSidebar(allPosts.length);
---

<BaseLayout title={`Archive ${year}`} description={`Entries published in ${year}.`}>
	<h1 class="font-display text-text mb-6 text-2xl font-bold">{year}</h1>

	<div class={showSidebar ? 'grid gap-10 md:grid-cols-[1fr_13rem]' : ''}>
		<div class="min-w-0">
			<EntryList posts={posts} label="Entries" />
		</div>
		{showSidebar && <Sidebar posts={allPosts} />}
	</div>
</BaseLayout>
