---
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';

// PLACEHOLDER: rewrite this in your own words before sharing the site.
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
	<div class="mx-auto max-w-2xl">
		<h1 class="font-display text-text text-3xl font-bold">About</h1>

		<div class="prose-body mt-6">
			<p>
				I'm Sam Broughton, a cloud and DevOps engineer. I work mostly with Azure, Microsoft 365 and
				the Microsoft security stack, and this is where I write the notes I wish I'd found first.
			</p>

			<p>
				This is a personal site. Opinions are mine, not my employer's, and nothing here is
				affiliated with or endorsed by Microsoft.
			</p>
		</div>
	</div>
</BaseLayout>
